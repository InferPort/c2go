  function showView(isDashboard: boolean) {
    const loader = document.getElementById('view-loader');
    const dashView = document.getElementById('view-dashboard');
    const wizView = document.getElementById('view-wizard');
    const modeBadge = document.getElementById('header-mode-badge');
    const badgeText = document.getElementById('header-badge-text');
    const badgeDot = document.getElementById('header-badge-dot');

    if (loader) loader.classList.add('hidden');

    if (isDashboard) {
      if (dashView) dashView.classList.remove('hidden');
      if (wizView) wizView.classList.add('hidden');
      if (modeBadge) {
        modeBadge.className = 'px-2 py-0.5 rounded bg-emerald-500/15 text-[10px] font-mono text-emerald-300 border border-emerald-500/30 flex items-center gap-1.5 font-medium';
        if (badgeDot) badgeDot.className = 'w-1.5 h-1.5 rounded-full bg-emerald-400';
        if (badgeText) badgeText.innerText = 'Active Config';
      }
      renderDashDomains();
      renderDashInterfacesList();
      renderHistoryTable();
    } else {
      if (dashView) dashView.classList.add('hidden');
      if (wizView) wizView.classList.remove('hidden');
      if (modeBadge) {
        modeBadge.className = 'px-2 py-0.5 rounded bg-zinc-850 text-[10px] font-mono text-zinc-400 border border-zinc-750 flex items-center gap-1.5';
        if (badgeDot) badgeDot.className = 'w-1.5 h-1.5 rounded-full bg-zinc-500';
        if (badgeText) badgeText.innerText = 'Setup Wizard';
      }
      goToStep(1);
    }
  }

  function showDashAlert(msg: string, isError = false) {
    const box = document.getElementById('dash-alert-box');
    if (!box) return;
    box.className = `p-3.5 rounded-lg text-xs font-medium mb-5 flex items-center gap-2.5 ${
      isError ? 'bg-red-500/10 text-red-400 border border-red-500/20' : 'bg-emerald-500/10 text-emerald-400 border border-emerald-500/20'
    }`;
    box.innerText = msg;
    box.classList.remove('hidden');
  }

  function hideDashAlert() {
    const box = document.getElementById('dash-alert-box');
    if (box) box.classList.add('hidden');
  }

  function showAlert(msg: string, isError = true) {
    const box = document.getElementById('alert-box');
    if (!box) return;
    box.className = `p-3.5 rounded-lg text-xs font-medium mb-5 flex items-center gap-2.5 ${
      isError ? 'bg-red-500/10 text-red-400 border border-red-500/20' : 'bg-emerald-500/10 text-emerald-400 border border-emerald-500/20'
    }`;
    box.innerText = msg;
    box.classList.remove('hidden');
  }

  function hideAlert() {
    const box = document.getElementById('alert-box');
    if (box) box.classList.add('hidden');
  }

  function goToStep(num: number) {
    hideAlert();
    for (let i = 1; i <= 5; i++) {
      const el = document.getElementById(`step-${i}`);
      const nav = document.getElementById(`nav-step-${i}`);
      if (el) el.classList.add('hidden');
      if (nav) {
        nav.classList.remove('active');
        const icon = nav.querySelector('.step-nav-icon');
        if (i === num) {
          nav.classList.add('active');
          if (icon) {
            icon.className = 'step-nav-icon w-6 h-6 rounded-md bg-rose-600 text-white flex items-center justify-center text-xs font-bold flex-shrink-0 mt-0.5 shadow-sm shadow-rose-950';
            icon.innerText = i.toString();
          }
        } else if (i < num) {
          nav.classList.add('completed');
          if (icon) {
            icon.className = 'step-nav-icon w-6 h-6 rounded-md bg-emerald-500/20 text-emerald-400 border border-emerald-500/40 flex items-center justify-center text-xs font-bold flex-shrink-0 mt-0.5';
            icon.innerHTML = '<svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="M20 6 9 17l-5-5"/></svg>';
          }
        } else {
          nav.classList.remove('completed');
          if (icon) {
            icon.className = 'step-nav-icon w-6 h-6 rounded-md bg-zinc-800 text-zinc-400 border border-zinc-700 flex items-center justify-center text-xs font-bold flex-shrink-0 mt-0.5';
            icon.innerText = i.toString();
          }
        }
      }
    }
    const target = document.getElementById(`step-${num}`);
    if (target) target.classList.remove('hidden');
    if (num === 2) renderZonesGrid();
    if (num === 3 && selectedZones.length > 0) loadRecordsForZone(currentZoneIndex);
    if (num === 4) renderInterfacesList();
    updateSummary();
  }

  function renderHistoryTable() {
    const tbody = document.getElementById('history-table-body');
    const countBadge = document.getElementById('history-count-badge');
    if (!tbody) return;

    if (countBadge) countBadge.innerText = `${historyEntries.length} event${historyEntries.length === 1 ? '' : 's'}`;

    if (!historyEntries || historyEntries.length === 0) {
      tbody.innerHTML = `
        <tr>
          <td colspan="3" class="py-6 text-center text-zinc-500 font-sans text-xs">No IP change events recorded yet in history.json</td>
        </tr>
      `;
      return;
    }

    tbody.innerHTML = '';
    // Reverse so latest is on top
    const reversed = [...historyEntries].reverse();

    reversed.forEach((entry, idx) => {
      const tr = document.createElement('tr');
      tr.className = 'hover:bg-zinc-800/30 transition-colors';

      let timeFormatted = entry.timestamp;
      try {
        const d = new Date(entry.timestamp);
        timeFormatted = d.toLocaleString();
      } catch (_) {}

      const isCurrent = entry.ip === currentPublicIP;

      tr.innerHTML = `
        <td class="py-2.5 px-3 text-zinc-400">${timeFormatted}</td>
        <td class="py-2.5 px-3 font-semibold text-zinc-200">
          <div class="flex items-center gap-2">
            <span>${entry.ip}</span>
            ${isCurrent ? '<span class="px-1.5 py-0.2 rounded text-[10px] font-mono bg-emerald-500/15 text-emerald-300 border border-emerald-500/30">Current</span>' : ''}
          </div>
        </td>
        <td class="py-2.5 px-3 text-right">
          <span class="inline-flex items-center gap-1 text-[11px] text-emerald-400">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span> Synced
          </span>
        </td>
      `;
      tbody.appendChild(tr);
    });
  }

  function updateServiceStatus() {
    const pill = document.getElementById('service-status-pill');
    const pillText = document.getElementById('service-pill-text');
    const cmdEl = document.getElementById('cmd-to-run');
    const noteEl = document.getElementById('os-help-note');
    const cmdTitle = document.getElementById('lbl-cmd-title');

    // Dashboard elements
    const dashCmdEl = document.getElementById('dash-cmd-to-run');
    const dashNoteEl = document.getElementById('dash-os-help-note');
    const dashCmdTitle = document.getElementById('dash-lbl-cmd-title');
    const dashKpiPill = document.getElementById('dash-kpi-pill');
    const dashKpiLabel = document.getElementById('dash-kpi-service-label');
    const dashKpiSub = document.getElementById('dash-kpi-service-sub');

    if (!serviceStatus) return;

    const cmdStr = serviceStatus.suggested_cmd || './c2go';
    const noteStr = serviceStatus.action_note || 'Run ./c2go in your terminal.';

    if (cmdEl) cmdEl.innerText = cmdStr;
    if (dashCmdEl) dashCmdEl.innerText = cmdStr;
    if (noteEl) noteEl.innerText = noteStr;
    if (dashNoteEl) dashNoteEl.innerText = noteStr;

    if (dashKpiLabel) dashKpiLabel.innerText = serviceStatus.status_label;
    if (dashKpiSub) dashKpiSub.innerHTML = `<span>Target:</span> <span class="text-zinc-300">${cmdStr}</span>`;

    if (dashKpiPill) {
      if (serviceStatus.is_running) dashKpiPill.className = 'w-2 h-2 rounded-full bg-emerald-400 animate-pulse';
      else if (serviceStatus.is_installed) dashKpiPill.className = 'w-2 h-2 rounded-full bg-amber-400';
      else dashKpiPill.className = 'w-2 h-2 rounded-full bg-zinc-500';
    }

    const titleStr = serviceStatus.is_running
      ? (currentLang === 'es' ? 'Comando para reiniciar el servicio:' : 'Command to restart the service:')
      : (currentLang === 'es' ? 'Comando para iniciar c2go:' : 'Command to start c2go:');

    if (cmdTitle) cmdTitle.innerText = titleStr;
    if (dashCmdTitle) dashCmdTitle.innerText = titleStr;

    if (pill && pillText) {
      pillText.innerText = serviceStatus.status_label;
      if (serviceStatus.is_running) {
        pill.className = 'flex items-center gap-1.5 px-2.5 py-0.5 rounded text-[11px] font-mono font-medium bg-emerald-500/15 text-emerald-300 border border-emerald-500/30';
        pill.innerHTML = `<span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span><span>${serviceStatus.status_label}</span>`;
      } else if (serviceStatus.is_installed) {
        pill.className = 'flex items-center gap-1.5 px-2.5 py-0.5 rounded text-[11px] font-mono font-medium bg-amber-500/15 text-amber-300 border border-amber-500/30';
        pill.innerHTML = `<span class="w-1.5 h-1.5 rounded-full bg-amber-400"></span><span>${serviceStatus.status_label}</span>`;
      } else {
        pill.className = 'flex items-center gap-1.5 px-2.5 py-0.5 rounded text-[11px] font-mono font-medium bg-zinc-800 text-zinc-300 border border-zinc-700';
        pill.innerHTML = `<span class="w-1.5 h-1.5 rounded-full bg-zinc-400"></span><span>${serviceStatus.status_label}</span>`;
      }
    }
  }

  function renderInterfacesList() {
    const container = document.getElementById('interfaces-list');
    const countEl = document.getElementById('lbl-nics-count');
    renderGenericNICList(container, countEl);
  }

  function renderDashInterfacesList() {
    const container = document.getElementById('dash-interfaces-list');
    const countEl = document.getElementById('dash-nics-badge-count');
    renderGenericNICList(container, countEl);
  }

  function renderGenericNICList(container: HTMLElement | null, countEl: HTMLElement | null) {
    if (!container) return;
    if (countEl) countEl.innerText = `${detectedInterfaces.length} detected`;

    if (!detectedInterfaces || detectedInterfaces.length === 0) {
      container.innerHTML = `<div class="text-xs text-zinc-500 py-4 text-center border border-zinc-800/60 rounded-lg">No physical network adapters found. Using default system routing.</div>`;
      return;
    }

    const orderedList: { iface: NetworkInterface; isSelected: boolean; priority: number }[] = [];
    preferredInterfaces.forEach((name, idx) => {
      const found = detectedInterfaces.find(i => i.name === name);
      if (found) {
        orderedList.push({ iface: found, isSelected: true, priority: idx + 1 });
      } else {
        orderedList.push({ iface: { name, up: false, ips: [], mac: '' }, isSelected: true, priority: idx + 1 });
      }
    });

    detectedInterfaces.forEach(i => {
      if (!preferredInterfaces.includes(i.name)) {
        orderedList.push({ iface: i, isSelected: false, priority: 0 });
      }
    });

    container.innerHTML = '';

    orderedList.forEach((item) => {
      const { iface, isSelected, priority } = item;
      const isFirst = isSelected && priority === 1;
      const isLastSelected = isSelected && priority === preferredInterfaces.length;

      const card = document.createElement('div');
      card.className = `p-3 rounded-lg border transition-all duration-150 flex items-center justify-between gap-3 ${
        isSelected
          ? 'bg-zinc-900/90 border-rose-500/50 shadow-sm shadow-rose-950/20 ring-1 ring-rose-500/20'
          : 'bg-zinc-950/60 border-zinc-800/80 opacity-70 hover:opacity-100 hover:border-zinc-700'
      }`;

      const ipsText = iface.ips && iface.ips.length > 0 ? iface.ips.join(', ') : 'No IP assigned';

      card.innerHTML = `
        <div class="flex items-center gap-3 min-w-0">
          <button type="button" class="nic-toggle-btn w-5 h-5 rounded border flex items-center justify-center transition-colors flex-shrink-0 cursor-pointer ${
            isSelected ? 'bg-rose-600 border-rose-600 text-white' : 'border-zinc-700 bg-zinc-900 hover:border-zinc-500'
          }" data-name="${iface.name}">
            ${isSelected ? '<svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="M20 6 9 17l-5-5"/></svg>' : ''}
          </button>

          <div class="min-w-0 space-y-0.5">
            <div class="flex items-center gap-2">
              <span class="font-mono font-semibold text-xs sm:text-sm text-zinc-100">${iface.name}</span>
              <span class="px-1.5 py-0.2 rounded text-[10px] font-mono border flex-shrink-0 ${
                iface.up ? 'bg-emerald-500/15 text-emerald-300 border-emerald-500/30' : 'bg-zinc-800 text-zinc-500 border-zinc-700'
              }">${iface.up ? 'UP' : 'DOWN'}</span>
              ${isSelected ? `
                <span class="px-1.5 py-0.2 rounded text-[10px] font-mono font-semibold bg-rose-500/20 text-rose-300 border border-rose-500/30">
                  #${priority} ${priority === 1 ? '(Primary)' : ''}
                </span>
              ` : '<span class="text-[10px] text-zinc-500 font-mono">(Excluded)</span>'}
            </div>
            <div class="text-[11px] font-mono text-zinc-400 truncate flex items-center gap-2">
              <span class="text-zinc-300">${ipsText}</span>
              ${iface.mac ? `<span class="text-zinc-600 text-[10px]">MAC: ${iface.mac}</span>` : ''}
            </div>
          </div>
        </div>

        <div class="flex items-center gap-1 flex-shrink-0">
          ${isSelected ? `
            <button type="button" class="btn-nic-up p-1.5 rounded bg-zinc-800 hover:bg-zinc-700 text-zinc-300 hover:text-white border border-zinc-700 disabled:opacity-30 disabled:cursor-not-allowed transition-all cursor-pointer" data-name="${iface.name}" ${isFirst ? 'disabled' : ''} title="Move Up (Higher Priority)">
              <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="m18 15-6-6-6 6"/></svg>
            </button>
            <button type="button" class="btn-nic-down p-1.5 rounded bg-zinc-800 hover:bg-zinc-700 text-zinc-300 hover:text-white border border-zinc-700 disabled:opacity-30 disabled:cursor-not-allowed transition-all cursor-pointer" data-name="${iface.name}" ${isLastSelected ? 'disabled' : ''} title="Move Down (Lower Priority)">
              <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="m6 9 6 6 6-6"/></svg>
            </button>
          ` : `
            <button type="button" class="btn-nic-add px-2.5 py-1 rounded bg-zinc-800 hover:bg-zinc-700 text-zinc-300 text-xs font-medium border border-zinc-700 transition-all cursor-pointer" data-name="${iface.name}">
              + Prioritize
            </button>
          `}
        </div>
      `;

      container.appendChild(card);
    });

    container.querySelectorAll('.nic-toggle-btn, .btn-nic-add').forEach(el => {
      el.addEventListener('click', (e) => {
        const target = e.currentTarget as HTMLElement;
        const name = target.getAttribute('data-name');
        if (!name) return;
        if (preferredInterfaces.includes(name)) {
          preferredInterfaces = preferredInterfaces.filter(n => n !== name);
        } else {
          preferredInterfaces.push(name);
        }
        renderInterfacesList();
        renderDashInterfacesList();
        updateSummary();
      });
    });

    container.querySelectorAll('.btn-nic-up').forEach(el => {
      el.addEventListener('click', (e) => {
        const target = e.currentTarget as HTMLElement;
        const name = target.getAttribute('data-name');
        if (!name) return;
        const idx = preferredInterfaces.indexOf(name);
        if (idx > 0) {
          const temp = preferredInterfaces[idx - 1];
          preferredInterfaces[idx - 1] = preferredInterfaces[idx];
          preferredInterfaces[idx] = temp;
          renderInterfacesList();
          renderDashInterfacesList();
          updateSummary();
        }
      });
    });

    container.querySelectorAll('.btn-nic-down').forEach(el => {
      el.addEventListener('click', (e) => {
        const target = e.currentTarget as HTMLElement;
        const name = target.getAttribute('data-name');
        if (!name) return;
        const idx = preferredInterfaces.indexOf(name);
        if (idx >= 0 && idx < preferredInterfaces.length - 1) {
          const temp = preferredInterfaces[idx + 1];
          preferredInterfaces[idx + 1] = preferredInterfaces[idx];
          preferredInterfaces[idx] = temp;
          renderInterfacesList();
          renderDashInterfacesList();
          updateSummary();
        }
      });
    });
  }

  function renderDashDomains() {
    const select = document.getElementById('dash-domain-select') as HTMLSelectElement;
    if (!select) return;
    select.innerHTML = '';

    if (selectedZones.length === 0) {
      select.innerHTML = '<option value="">No domains configured</option>';
      renderDashRecordsGrid('');
      return;
    }

    selectedZones.forEach(z => {
      const opt = document.createElement('option');
      opt.value = z.name;
      opt.innerText = z.name;
      select.appendChild(opt);
    });

    const activeDomain = select.value || selectedZones[0]?.name || '';
    renderDashRecordsGrid(activeDomain);
  }

  function renderDashRecordsGrid(domain: string) {
    const container = document.getElementById('dash-records-grid');
    if (!container) return;
    container.innerHTML = '';
    if (!domain) return;

    const state = zoneRecordMap[domain];
    if (!state || !state.records || state.records.length === 0) {
      container.innerHTML = '<div class="col-span-2 text-xs text-zinc-500 py-6 text-center">No records monitored for this domain. Add one below:</div>';
      return;
    }

    state.records.forEach(rec => {
      const isSelected = state.selected.has(rec.id);
      const isMatch = currentPublicIP !== '' && rec.content === currentPublicIP;
      const ipLabel = rec.content ? rec.content : 'Unassigned';

      const div = document.createElement('div');
      div.className = `flex items-center justify-between p-3.5 bg-zinc-950 border rounded-lg cursor-pointer transition-all duration-150 ${
        isSelected ? 'border-rose-500 bg-rose-500/10 shadow-sm shadow-rose-950/40 ring-1 ring-rose-500/50' : 'border-zinc-800 hover:border-zinc-700 hover:bg-zinc-900'
      }`;
      div.onclick = () => {
        if (state.selected.has(rec.id)) state.selected.delete(rec.id);
        else state.selected.add(rec.id);
        renderDashRecordsGrid(domain);
        updateSummary();
      };
      div.innerHTML = `
        <div class="pr-2 truncate space-y-1">
          <div class="font-semibold text-xs sm:text-sm text-zinc-100 flex items-center gap-2 truncate">
            <span class="truncate">${rec.name}</span>
            <span class="px-1.5 py-0.5 rounded text-[10px] font-mono border flex-shrink-0 ${
              rec.proxied ? 'bg-amber-500/15 text-amber-300 border-amber-500/30' : 'bg-zinc-800 text-zinc-400 border-zinc-700'
            }">${rec.proxied ? 'Proxied' : 'DNS'}</span>
            ${isMatch ? '<span class="px-1.5 py-0.5 rounded text-[10px] font-mono border bg-emerald-500/15 text-emerald-300 border-emerald-500/30 flex items-center gap-1 flex-shrink-0"><span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>Current IP</span>' : ''}
          </div>
          <div class="text-[11px] font-mono flex items-center gap-1.5 ${isMatch ? 'text-emerald-400 font-semibold' : 'text-zinc-400'}">
            <span>IP:</span>
            <span>${ipLabel}</span>
          </div>
        </div>
        <div class="w-4 h-4 rounded border flex items-center justify-center transition-colors flex-shrink-0 ${
          isSelected ? 'bg-rose-600 border-rose-600' : 'border-zinc-700 bg-zinc-900'
        }">
          ${isSelected ? '<svg class="w-3 h-3 text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="M20 6 9 17l-5-5"/></svg>' : ''}
        </div>
      `;
      container.appendChild(div);
    });
  }

  async function loadInitial() {
    try {
      const res = await fetch('/api/initial-data');
      if (res.ok) {
        const data = await res.json();
        if (data.service_status) serviceStatus = data.service_status;
        if (data.network_interfaces) detectedInterfaces = data.network_interfaces;
        if (data.preferred_interfaces) preferredInterfaces = data.preferred_interfaces;
        if (data.history_entries) historyEntries = data.history_entries;

        if (data.language) {
          const langSelect = document.getElementById('input-lang') as HTMLSelectElement;
          if (langSelect) langSelect.value = data.language;
          switchLanguage(data.language);
        }

        if (data.token) {
          const tokenInput = document.getElementById('input-token') as HTMLInputElement;
          const dashToken = document.getElementById('dash-input-token') as HTMLInputElement;
          if (tokenInput) tokenInput.value = data.token;
          if (dashToken) dashToken.value = data.token;
        }
        if (data.update_interval) {
          const intervalInput = document.getElementById('input-interval') as HTMLInputElement;
          const dashInterval = document.getElementById('dash-input-interval') as HTMLInputElement;
          if (intervalInput) intervalInput.value = data.update_interval;
          if (dashInterval) dashInterval.value = data.update_interval;
          
          document.querySelectorAll('.dash-interval-chip, .interval-chip').forEach(chip => {
            if (chip.getAttribute('data-val') === data.update_interval.toString()) {
              chip.classList.add('active');
            } else {
              chip.classList.remove('active');
            }
          });
        }
        if (data.history_enabled !== undefined) {
          const histInput = document.getElementById('input-history') as HTMLInputElement;
          const dashHist = document.getElementById('dash-input-history') as HTMLInputElement;
          if (histInput) histInput.checked = data.history_enabled;
          if (dashHist) dashHist.checked = data.history_enabled;
        }
        if (data.check_updates !== undefined) {
          const updateInput = document.getElementById('input-updates') as HTMLInputElement;
          const dashUpdates = document.getElementById('dash-input-updates') as HTMLInputElement;
          if (updateInput) updateInput.checked = data.check_updates;
          if (dashUpdates) dashUpdates.checked = data.check_updates;
        }
        if (data.auto_update !== undefined) {
          const autoInput = document.getElementById('input-autoupdate') as HTMLInputElement;
          const dashAuto = document.getElementById('dash-input-autoupdate') as HTMLInputElement;
          if (autoInput) autoInput.checked = data.auto_update;
          if (dashAuto) dashAuto.checked = data.auto_update;
        }
        if (data.public_ip) {
          currentPublicIP = data.public_ip;
          const ipVal = document.getElementById('top-ip-val');
          if (ipVal) ipVal.innerText = currentPublicIP;
          const kpiIP = document.getElementById('kpi-public-ip');
          if (kpiIP) kpiIP.innerText = currentPublicIP;
        }

        if (data.is_configured && data.managed_zones && data.managed_zones.length > 0) {
          isConfigured = true;
          availableZones = data.managed_zones.map((mz: any) => ({ name: mz.domain }));
          selectedZones = [...availableZones];
          data.managed_zones.forEach((mz: any) => {
            const recs = (mz.records || []).map((r: any) => {
              if (typeof r === 'string') {
                return { id: r, name: r, type: 'A', content: currentPublicIP || '', proxied: false };
              }
              return r;
            });
            zoneRecordMap[mz.domain] = {
              records: recs,
              selected: new Set(recs.map((r: any) => r.id))
            };
          });

          showView(true);
        } else {
          isConfigured = false;
          showView(false);
        }

        updateServiceStatus();
        renderInterfacesList();
        renderDashInterfacesList();
        renderHistoryTable();
        updateSummary();
      }
    } catch (e) {
      console.warn('Initial data warning:', e);
      showView(false);
    }
  }

  async function validateStep1() {
    const tokenInput = document.getElementById('input-token') as HTMLInputElement;
    const token = tokenInput ? tokenInput.value.trim() : '';
    const t = translations[currentLang] || translations.en;

    if (!token) {
      showAlert(`${t.token_label} is required.`);
      return;
    }

    const spin = document.getElementById('btn-spin-step1');
    const text = document.getElementById('btn-text-step1');
    if (spin) spin.classList.remove('hidden');
    if (text) text.classList.add('hidden');
    hideAlert();

    try {
      const res = await fetch('/api/verify-token', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ token })
      });
      const data = await res.json();
      if (!res.ok || !data.success) {
        throw new Error(data.error || t.token_invalid);
      }

      availableZones = (data.zones || []).map((z: any) => {
        if (typeof z === 'string') return { name: z };
        return { name: z.name || z.id || '' };
      }).filter((z: CloudflareZone) => z.name !== '');

      if (data.public_ip) {
        currentPublicIP = data.public_ip;
        const ipVal = document.getElementById('top-ip-val');
        if (ipVal) ipVal.innerText = currentPublicIP;
      }

      const dashToken = document.getElementById('dash-input-token') as HTMLInputElement;
      if (dashToken) dashToken.value = token;

      renderZonesGrid();
      goToStep(2);
    } catch (err: any) {
      showAlert(err.message);
    } finally {
      if (spin) spin.classList.add('hidden');
      if (text) text.classList.remove('hidden');
    }
  }

  function renderZonesGrid(filter = '') {
    const container = document.getElementById('zones-grid');
    if (!container) return;
    container.innerHTML = '';

    const filtered = availableZones.filter(z => z.name.toLowerCase().includes(filter.toLowerCase()));

    filtered.forEach(zone => {
      const isSelected = selectedZones.some(z => z.name === zone.name);
      const div = document.createElement('div');
      div.className = `flex items-center justify-between p-3.5 bg-zinc-950 border rounded-lg cursor-pointer transition-all duration-150 ${
        isSelected ? 'border-rose-500 bg-rose-500/10 shadow-sm shadow-rose-950/40 ring-1 ring-rose-500/50' : 'border-zinc-800 hover:border-zinc-700 hover:bg-zinc-900'
      }`;
      div.onclick = () => {
        const idx = selectedZones.findIndex(z => z.name === zone.name);
        if (idx >= 0) selectedZones.splice(idx, 1);
        else selectedZones.push(zone);
        renderZonesGrid(filter);
        updateSummary();
      };
      div.innerHTML = `
        <div class="pr-2 truncate">
          <div class="font-semibold text-xs sm:text-sm text-zinc-100 tracking-tight truncate">${zone.name}</div>
          <div class="text-[10px] text-zinc-400 font-mono mt-0.5 flex items-center gap-1.5">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
            Cloudflare Zone
          </div>
        </div>
        <div class="w-4 h-4 rounded border flex items-center justify-center transition-colors flex-shrink-0 ${
          isSelected ? 'bg-rose-600 border-rose-600' : 'border-zinc-700 bg-zinc-900'
        }">
          ${isSelected ? '<svg class="w-3 h-3 text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="M20 6 9 17l-5-5"/></svg>' : ''}
        </div>
      `;
      container.appendChild(div);
    });
  }

  async function loadRecordsForZone(index: number) {
    const zone = selectedZones[index];
    const t = translations[currentLang] || translations.en;
    const badge = document.getElementById('zone-tab-badge');
    if (badge) badge.innerText = `${zone.name} [${index + 1}/${selectedZones.length}]`;

    const nextBtnText = document.getElementById('btn-text-step3');
    if (nextBtnText) {
      nextBtnText.innerText = index === selectedZones.length - 1 ? t.finish_records : t.next_domain;
    }

    if (!zoneRecordMap[zone.name]) {
      try {
        const tokenInput = document.getElementById('input-token') as HTMLInputElement;
        const token = tokenInput ? tokenInput.value.trim() : '';
        const res = await fetch(`/api/zones/${encodeURIComponent(zone.name)}/records?token=${encodeURIComponent(token)}`);
        const data = await res.json();
        zoneRecordMap[zone.name] = {
          records: data.records || [],
          selected: new Set((data.records || []).map((r: any) => r.id))
        };
      } catch (e) {
        zoneRecordMap[zone.name] = { records: [], selected: new Set() };
      }
    }
    renderRecordsGrid(zone.name);
  }

  function renderRecordsGrid(domain: string) {
    const container = document.getElementById('records-grid');
    if (!container) return;
    container.innerHTML = '';
    const state = zoneRecordMap[domain];

    if (!state || !state.records || state.records.length === 0) {
      container.innerHTML = '<div class="col-span-2 text-xs text-zinc-500 py-6 text-center">No existing A records found. Create one below:</div>';
      return;
    }

    state.records.forEach(rec => {
      const isSelected = state.selected.has(rec.id);
      const isMatch = currentPublicIP !== '' && rec.content === currentPublicIP;
      const ipLabel = rec.content ? rec.content : 'Unassigned';

      const div = document.createElement('div');
      div.className = `flex items-center justify-between p-3.5 bg-zinc-950 border rounded-lg cursor-pointer transition-all duration-150 ${
        isSelected ? 'border-rose-500 bg-rose-500/10 shadow-sm shadow-rose-950/40 ring-1 ring-rose-500/50' : 'border-zinc-800 hover:border-zinc-700 hover:bg-zinc-900'
      }`;
      div.onclick = () => {
        if (state.selected.has(rec.id)) state.selected.delete(rec.id);
        else state.selected.add(rec.id);
        renderRecordsGrid(domain);
        updateSummary();
      };
      div.innerHTML = `
        <div class="pr-2 truncate space-y-1">
          <div class="font-semibold text-xs sm:text-sm text-zinc-100 flex items-center gap-2 truncate">
            <span class="truncate">${rec.name}</span>
            <span class="px-1.5 py-0.5 rounded text-[10px] font-mono border flex-shrink-0 ${
              rec.proxied ? 'bg-amber-500/15 text-amber-300 border-amber-500/30' : 'bg-zinc-800 text-zinc-400 border-zinc-700'
            }">${rec.proxied ? 'Proxied' : 'DNS'}</span>
            ${isMatch ? '<span class="px-1.5 py-0.5 rounded text-[10px] font-mono border bg-emerald-500/15 text-emerald-300 border-emerald-500/30 flex items-center gap-1 flex-shrink-0"><span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>Current IP</span>' : ''}
          </div>
          <div class="text-[11px] font-mono flex items-center gap-1.5 ${isMatch ? 'text-emerald-400 font-semibold' : 'text-zinc-400'}">
            <span>IP:</span>
            <span>${ipLabel}</span>
          </div>
        </div>
        <div class="w-4 h-4 rounded border flex items-center justify-center transition-colors flex-shrink-0 ${
          isSelected ? 'bg-rose-600 border-rose-600' : 'border-zinc-700 bg-zinc-900'
        }">
          ${isSelected ? '<svg class="w-3 h-3 text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="M20 6 9 17l-5-5"/></svg>' : ''}
        </div>
      `;
      container.appendChild(div);
    });
  }

  async function createNewRecord(isDash = false) {
    const domainSelect = document.getElementById('dash-domain-select') as HTMLSelectElement;
    const domain = isDash ? domainSelect?.value : selectedZones[currentZoneIndex]?.name;
    if (!domain) return;

    const hostInput = document.getElementById(isDash ? 'dash-new-record-name' : 'new-record-name') as HTMLInputElement;
    const proxiedInput = document.getElementById(isDash ? 'dash-new-record-proxied' : 'new-record-proxied') as HTMLInputElement;
    const name = hostInput ? hostInput.value.trim() : '';
    if (!name) return;

    const fullName = name.includes('.') ? name : `${name}.${domain}`;
    const tokenInput = document.getElementById(isDash ? 'dash-input-token' : 'input-token') as HTMLInputElement;
    const token = tokenInput ? tokenInput.value.trim() : '';

    try {
      const res = await fetch(`/api/zones/${encodeURIComponent(domain)}/records`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          token,
          name: fullName,
          proxied: proxiedInput.checked,
          content: currentPublicIP || '1.1.1.1'
        })
      });
      const data = await res.json();
      if (!res.ok || !data.success) {
        throw new Error(data.error || 'Failed to create record');
      }

      const state = zoneRecordMap[domain] || { records: [], selected: new Set() };
      state.records.push(data.record);
      state.selected.add(data.record.id);
      zoneRecordMap[domain] = state;
      hostInput.value = '';

      if (isDash) {
        renderDashRecordsGrid(domain);
        showDashAlert(`Record ${fullName} created successfully!`, false);
      } else {
        renderRecordsGrid(domain);
      }
      updateSummary();
    } catch (err: any) {
      if (isDash) showDashAlert(err.message, true);
      else showAlert(err.message);
    }
  }

  function updateSummary() {
    const t = translations[currentLang] || translations.en;
    let totalRecords = 0;
    selectedZones.forEach(z => {
      const s = zoneRecordMap[z.name];
      if (s) totalRecords += s.selected.size;
    });

    const setTxt = (id: string, text: string) => {
      const el = document.getElementById(id);
      if (el) el.innerText = text;
    };

    const intervalVal = (document.getElementById('input-interval') as HTMLInputElement)?.value || 
                        (document.getElementById('dash-input-interval') as HTMLInputElement)?.value || '300';
    const histChecked = (document.getElementById('input-history') as HTMLInputElement)?.checked ?? 
                        (document.getElementById('dash-input-history') as HTMLInputElement)?.checked ?? true;
    const autoChecked = (document.getElementById('input-autoupdate') as HTMLInputElement)?.checked ?? 
                        (document.getElementById('dash-input-autoupdate') as HTMLInputElement)?.checked ?? false;

    // Top KPI Cards
    setTxt('kpi-records-count', totalRecords.toString());
    setTxt('kpi-records-sub', totalRecords === 1 ? 'record' : 'records');
    setTxt('kpi-zones-count', `${selectedZones.length} ${selectedZones.length === 1 ? 'zone' : 'zones'}`);
    setTxt('kpi-interval-val', `${intervalVal}s`);
    const intervalMins = Math.round(parseInt(intervalVal) / 60);
    setTxt('kpi-interval-human', `(${intervalMins}m)`);
    setTxt('kpi-primary-nic', preferredInterfaces.length > 0 ? preferredInterfaces[0] : (t.default_routing || 'Auto Routing'));

    // Wizard Snapshot
    setTxt('snap-val-zones', `${selectedZones.length} ${selectedZones.length === 1 ? 'zone' : 'zones'}`);
    setTxt('snap-val-records', `${totalRecords} ${totalRecords === 1 ? 'record' : 'records'}`);
    setTxt('snap-val-interval', `${intervalVal}s`);
    setTxt('snap-val-nics', preferredInterfaces.length > 0 ? preferredInterfaces.join(', ') : (t.default_routing || 'Default'));
    setTxt('snap-val-history', histChecked ? t.enabled : t.disabled);
    setTxt('snap-val-autoupdate', autoChecked ? t.enabled : t.disabled);

    // Review step table
    setTxt('rev-val-domains', selectedZones.length.toString());
    setTxt('rev-val-records', totalRecords.toString());
    setTxt('rev-val-interval', `${intervalVal}s`);
    setTxt('rev-val-nics', preferredInterfaces.length > 0 ? preferredInterfaces.map((nic, idx) => `#${idx+1}: ${nic}`).join(' → ') : (t.default_routing || 'Default Routing'));
    setTxt('rev-val-history', histChecked ? t.enabled : t.disabled);
    setTxt('rev-val-autoupdate', autoChecked ? t.enabled : t.disabled);
  }

  async function saveConfiguration(fromDashboard = false) {
    const t = translations[currentLang] || translations.en;
    const tokenInput = document.getElementById(fromDashboard ? 'dash-input-token' : 'input-token') as HTMLInputElement;
    const intervalInput = document.getElementById(fromDashboard ? 'dash-input-interval' : 'input-interval') as HTMLInputElement;
    const histInput = document.getElementById(fromDashboard ? 'dash-input-history' : 'input-history') as HTMLInputElement;
    const updatesInput = document.getElementById(fromDashboard ? 'dash-input-updates' : 'input-updates') as HTMLInputElement;
    const autoInput = document.getElementById(fromDashboard ? 'dash-input-autoupdate' : 'input-autoupdate') as HTMLInputElement;

    const managedZones = selectedZones.map(zone => {
      const state = zoneRecordMap[zone.name];
      const selectedRecs = (state ? state.records : []).filter(r => state && state.selected.has(r.id)).map(r => ({
        id: r.id,
        name: r.name,
        type: 'A',
        proxied: r.proxied
      }));
      return {
        domain: zone.name,
        records: selectedRecs
      };
    });

    const payload: ConfigPayload = {
      token: tokenInput ? tokenInput.value.trim() : '',
      language: currentLang,
      update_interval: parseInt(intervalInput ? intervalInput.value : '300') || 300,
      history_enabled: histInput ? histInput.checked : true,
      check_updates: updatesInput ? updatesInput.checked : true,
      auto_update: autoInput ? autoInput.checked : false,
      preferred_interfaces: preferredInterfaces,
      managed_zones: managedZones
    };

    const spin = document.getElementById(fromDashboard ? 'dash-btn-spin-save' : 'btn-spin-save');
    const text = document.getElementById(fromDashboard ? 'dash-btn-text-save' : 'btn-text-save');
    if (spin) spin.classList.remove('hidden');
    if (text) text.classList.add('hidden');
    if (fromDashboard) hideDashAlert();
    else hideAlert();

    try {
      const res = await fetch('/api/save-config', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload)
      });
      const data = await res.json();
      if (!res.ok || !data.success) {
        throw new Error(data.error || 'Failed to save configuration');
      }

      isConfigured = true;

      if (fromDashboard) {
        showDashAlert(t.changes_saved || 'Changes saved successfully!', false);
        updateServiceStatus();
      } else {
        for (let i = 1; i <= 5; i++) {
          const el = document.getElementById(`step-${i}`);
          if (el) el.classList.add('hidden');
          const nav = document.getElementById(`nav-step-${i}`);
          if (nav) {
            nav.classList.remove('active');
            nav.classList.add('completed');
          }
        }
        const successEl = document.getElementById('step-success');
        if (successEl) successEl.classList.remove('hidden');
        updateServiceStatus();
      }
    } catch (err: any) {
      if (fromDashboard) showDashAlert(err.message, true);
      else showAlert(err.message);
    } finally {
      if (spin) spin.classList.add('hidden');
      if (text) text.classList.remove('hidden');
    }
  }

  // Event Listeners
  document.addEventListener('DOMContentLoaded', () => {
    document.getElementById('btn-relaunch-wizard')?.addEventListener('click', () => {
      showView(false);
    });

    document.getElementById('btn-goto-dashboard')?.addEventListener('click', () => {
      showView(true);
    });

    document.getElementById('dash-domain-select')?.addEventListener('change', (e) => {
      renderDashRecordsGrid((e.target as HTMLSelectElement).value);
    });

    const langSelect = document.getElementById('input-lang') as HTMLSelectElement;
    if (langSelect) {
      langSelect.addEventListener('change', (e) => {
        switchLanguage((e.target as HTMLSelectElement).value as 'en' | 'es');
      });
    }

    const setupTokenToggle = (btnId: string, inputId: string) => {
      document.getElementById(btnId)?.addEventListener('click', () => {
        const input = document.getElementById(inputId) as HTMLInputElement;
        const btn = document.getElementById(btnId);
        if (input && btn) {
          if (input.type === 'password') {
            input.type = 'text';
            btn.innerText = 'Hide';
          } else {
            input.type = 'password';
            btn.innerText = 'Show';
          }
        }
      });
    };
    setupTokenToggle('btn-toggle-token', 'input-token');
    setupTokenToggle('btn-dash-toggle-token', 'dash-input-token');

    const setupChips = (selector: string, inputId: string) => {
      document.querySelectorAll(selector).forEach(chip => {
        chip.addEventListener('click', () => {
          const val = chip.getAttribute('data-val');
          if (val) {
            const input = document.getElementById(inputId) as HTMLInputElement;
            if (input) input.value = val;
            document.querySelectorAll(selector).forEach(c => c.classList.remove('active'));
            chip.classList.add('active');
            updateSummary();
          }
        });
      });
    };
    setupChips('.interval-chip', 'input-interval');
    setupChips('.dash-interval-chip', 'dash-input-interval');

    ['input-history', 'dash-input-history', 'input-autoupdate', 'dash-input-autoupdate'].forEach(id => {
      document.getElementById(id)?.addEventListener('change', updateSummary);
    });

    document.getElementById('btn-step1-next')?.addEventListener('click', validateStep1);
    document.getElementById('btn-step2-back')?.addEventListener('click', () => goToStep(1));
    document.getElementById('btn-step2-next')?.addEventListener('click', async () => {
      const t = translations[currentLang] || translations.en;
      if (selectedZones.length === 0) {
        showAlert(t.must_select_zone);
        return;
      }
      currentZoneIndex = 0;
      await loadRecordsForZone(currentZoneIndex);
      goToStep(3);
    });

    document.getElementById('btn-step3-back')?.addEventListener('click', () => {
      if (currentZoneIndex > 0) {
        currentZoneIndex--;
        loadRecordsForZone(currentZoneIndex);
      } else {
        goToStep(2);
      }
    });

    document.getElementById('btn-step3-next')?.addEventListener('click', () => {
      const zone = selectedZones[currentZoneIndex];
      const state = zoneRecordMap[zone.name];
      const t = translations[currentLang] || translations.en;
      if (!state.selected || state.selected.size === 0) {
        showAlert(t.must_select_record);
        return;
      }
      if (currentZoneIndex < selectedZones.length - 1) {
        currentZoneIndex++;
        loadRecordsForZone(currentZoneIndex);
      } else {
        goToStep(4);
      }
    });

    document.getElementById('btn-add-record')?.addEventListener('click', () => createNewRecord(false));
    document.getElementById('btn-dash-add-record')?.addEventListener('click', () => createNewRecord(true));
    document.getElementById('btn-step4-back')?.addEventListener('click', () => goToStep(3));
    document.getElementById('btn-step4-next')?.addEventListener('click', () => goToStep(5));
    document.getElementById('btn-step5-back')?.addEventListener('click', () => goToStep(4));
    document.getElementById('btn-save-final')?.addEventListener('click', () => saveConfiguration(false));
    document.getElementById('btn-dash-save')?.addEventListener('click', () => saveConfiguration(true));

    const setupCopy = (btnId: string, cmdId: string, textId?: string) => {
      document.getElementById(btnId)?.addEventListener('click', () => {
        const cmdText = document.getElementById(cmdId)?.innerText || '';
        if (cmdText) {
          navigator.clipboard.writeText(cmdText).then(() => {
            if (textId) {
              const copyTextEl = document.getElementById(textId);
              if (copyTextEl) {
                copyTextEl.innerText = currentLang === 'es' ? '¡Copiado!' : 'Copied!';
                setTimeout(() => {
                  copyTextEl.innerText = currentLang === 'es' ? 'Copiar' : 'Copy';
                }, 2000);
              }
            }
          });
        }
      });
    };
    setupCopy('btn-copy-cmd', 'cmd-to-run', 'btn-copy-text');
    setupCopy('btn-dash-copy-cmd', 'dash-cmd-to-run', 'dash-btn-copy-text');
    setupCopy('btn-copy-kpi-ip', 'kpi-public-ip');

    loadInitial();
  });
</script>
