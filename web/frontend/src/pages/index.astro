<script>
  import { translations } from '../lib/i18n';
  import type { CloudflareZone, DNSRecord, ConfigPayload, NetworkInterface, ServiceStatusInfo, HistoryEntry } from '../lib/types';

  let currentLang: 'en' | 'es' = 'en';
  let availableZones: CloudflareZone[] = [];
  let selectedZones: CloudflareZone[] = [];
  let zoneRecordMap: Record<string, { records: DNSRecord[]; selected: Set<string> }> = {};
  let currentZoneIndex = 0;
  let currentPublicIP = '';
  let detectedInterfaces: NetworkInterface[] = [];
  let preferredInterfaces: string[] = [];
  let historyEntries: HistoryEntry[] = [];
  let serviceStatus: ServiceStatusInfo | null = null;
  let isConfigured = false;

  function switchLanguage(lang: 'en' | 'es') {
    currentLang = lang;
    const t = translations[lang] || translations.en;
    
    const setTxt = (id: string, text: string) => {
      const el = document.getElementById(id);
      if (el) el.innerText = text;
    };

    setTxt('nav-lbl-1', t.step1);
    setTxt('nav-lbl-2', t.step2);
    setTxt('nav-lbl-3', t.step3);
    setTxt('nav-lbl-4', t.step4);
    setTxt('nav-lbl-5', t.step5);
    setTxt('lbl-token', t.token_label);
    setTxt('btn-text-step1', t.verify_continue);
    setTxt('step2-title', t.select_zones);
    setTxt('step2-desc', t.select_zones_desc);
    setTxt('step3-title', t.select_records);
    setTxt('step3-desc', t.select_records_desc);
    setTxt('lbl-create-record-title', t.create_record_title);
    setTxt('btn-add-record', t.add_record);
    setTxt('lbl-interval', t.interval);
    setTxt('lbl-history', t.history);
    setTxt('lbl-history-desc', t.history_desc);
    setTxt('lbl-updates', t.updates);
    setTxt('lbl-updates-desc', t.updates_desc);
    setTxt('lbl-autoupdate', t.autoupdate);
    setTxt('lbl-autoupdate-desc', t.autoupdate_desc);
    setTxt('lbl-nics', t.network_interfaces || 'Network Interfaces (Multi-NIC Priority)');
    setTxt('lbl-nics-desc', t.network_interfaces_desc || 'Prioritize interfaces for IP detection.');
    setTxt('btn-text-save', t.save_finish);
    setTxt('lbl-success-title', t.success_title);
    setTxt('lbl-success-desc', t.success_desc);
