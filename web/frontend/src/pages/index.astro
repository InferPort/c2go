---
import Layout from '../layouts/Layout.astro';
---

<Layout title="c2go | Dynamic DNS Setup Wizard">
  <!-- Top Application Bar -->
  <header class="border-b border-zinc-800/80 bg-zinc-950/80 backdrop-blur-xl sticky top-0 z-50">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 h-14 flex items-center justify-between">
      <div class="flex items-center gap-3">
        <div class="w-7 h-7 rounded-lg bg-gradient-to-br from-rose-500 to-rose-700 flex items-center justify-center text-white shadow-sm shadow-rose-950/40">
          <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
        </div>
        <div class="flex items-center gap-2">
          <span class="font-bold text-sm text-zinc-100 tracking-tight">c2go</span>
          <span class="px-1.5 py-0.5 rounded bg-zinc-850 text-[10px] font-mono text-zinc-400 border border-zinc-750">Setup</span>
        </div>
      </div>

      <div class="flex items-center gap-3">
        <!-- Public IP Badge -->
        <div class="flex items-center gap-2 px-2.5 py-1 bg-zinc-900 border border-zinc-800 rounded-lg text-xs font-mono">
          <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
          <span class="text-zinc-400" id="top-ip-lbl">IP:</span>
          <span class="text-zinc-200 font-semibold" id="top-ip-val">Detecting...</span>
        </div>

        <!-- Language Switcher -->
        <select id="input-lang" class="px-2.5 py-1 bg-zinc-900 border border-zinc-800 rounded-lg text-xs text-zinc-300 focus:outline-none focus:border-rose-500 cursor-pointer font-medium">
          <option value="en">EN</option>
          <option value="es">ES</option>
        </select>
      </div>
    </div>
  </header>

  <!-- Main 2-Column App Grid -->
  <main class="max-w-6xl mx-auto w-full px-4 sm:px-6 py-6 sm:py-8 flex-1 grid grid-cols-1 lg:grid-cols-12 gap-6 sm:gap-8 items-start">
    
    <!-- Left Column: Step Navigation & Realtime Summary (4 cols) -->
    <aside class="lg:col-span-4 space-y-4">
      <!-- Stepper Nav Card -->
      <div class="bg-zinc-900/40 border border-zinc-800/80 rounded-xl p-4 space-y-1.5 backdrop-blur-sm">
        <h2 class="text-[11px] font-bold uppercase tracking-wider text-zinc-400 px-2 mb-2" id="sidebar-nav-title">Configuration Progress</h2>
        
        <div class="space-y-1" id="wizard-nav-list">
          <!-- Step 1 Nav -->
          <div class="step-nav-btn active flex items-start gap-3 p-2.5 rounded-lg transition-all cursor-pointer hover:bg-zinc-850/50" id="nav-step-1" onclick="goToStep(1)">
            <div class="step-nav-icon w-6 h-6 rounded-md bg-rose-600 text-white flex items-center justify-center text-xs font-bold flex-shrink-0 mt-0.5">1</div>
            <div>
              <div class="font-medium text-xs sm:text-sm text-zinc-100 step-nav-title" id="nav-lbl-1">Authentication</div>
              <div class="text-[11px] text-zinc-400 mt-0.5" id="nav-desc-1">Connect Cloudflare API token</div>
            </div>
          </div>

          <!-- Step 2 Nav -->
          <div class="step-nav-btn flex items-start gap-3 p-2.5 rounded-lg transition-all cursor-pointer hover:bg-zinc-850/50" id="nav-step-2">
            <div class="step-nav-icon w-6 h-6 rounded-md bg-zinc-800 text-zinc-400 border border-zinc-700 flex items-center justify-center text-xs font-bold flex-shrink-0 mt-0.5">2</div>
            <div>
              <div class="font-medium text-xs sm:text-sm text-zinc-400 step-nav-title" id="nav-lbl-2">Managed Domains</div>
              <div class="text-[11px] text-zinc-500 mt-0.5" id="nav-desc-2">Select zones to monitor</div>
            </div>
          </div>

          <!-- Step 3 Nav -->
          <div class="step-nav-btn flex items-start gap-3 p-2.5 rounded-lg transition-all cursor-pointer hover:bg-zinc-850/50" id="nav-step-3">
            <div class="step-nav-icon w-6 h-6 rounded-md bg-zinc-800 text-zinc-400 border border-zinc-700 flex items-center justify-center text-xs font-bold flex-shrink-0 mt-0.5">3</div>
            <div>
              <div class="font-medium text-xs sm:text-sm text-zinc-400 step-nav-title" id="nav-lbl-3">DNS Records</div>
              <div class="text-[11px] text-zinc-500 mt-0.5" id="nav-desc-3">Pick A records to update</div>
            </div>
          </div>

          <!-- Step 4 Nav -->
          <div class="step-nav-btn flex items-start gap-3 p-2.5 rounded-lg transition-all cursor-pointer hover:bg-zinc-850/50" id="nav-step-4">
            <div class="step-nav-icon w-6 h-6 rounded-md bg-zinc-800 text-zinc-400 border border-zinc-700 flex items-center justify-center text-xs font-bold flex-shrink-0 mt-0.5">4</div>
            <div>
              <div class="font-medium text-xs sm:text-sm text-zinc-400 step-nav-title" id="nav-lbl-4">Automation</div>
              <div class="text-[11px] text-zinc-500 mt-0.5" id="nav-desc-4">Sync intervals & auto-update</div>
            </div>
          </div>

          <!-- Step 5 Nav -->
          <div class="step-nav-btn flex items-start gap-3 p-2.5 rounded-lg transition-all cursor-pointer hover:bg-zinc-850/50" id="nav-step-5">
            <div class="step-nav-icon w-6 h-6 rounded-md bg-zinc-800 text-zinc-400 border border-zinc-700 flex items-center justify-center text-xs font-bold flex-shrink-0 mt-0.5">5</div>
            <div>
              <div class="font-medium text-xs sm:text-sm text-zinc-400 step-nav-title" id="nav-lbl-5">Review & Save</div>
              <div class="text-[11px] text-zinc-500 mt-0.5" id="nav-desc-5">Confirm and deploy config</div>
            </div>
          </div>
        </div>
      </div>

      <!-- Real-time Live Summary Widget -->
      <div class="bg-zinc-900/30 border border-zinc-800/60 rounded-xl p-4 space-y-3">
        <div class="flex items-center justify-between">
          <span class="text-[11px] font-bold uppercase tracking-wider text-zinc-400" id="sum-widget-title">Configuration Snapshot</span>
          <span class="px-2 py-0.5 rounded-full bg-rose-500/10 text-rose-300 border border-rose-500/20 text-[10px] font-mono font-medium">Live</span>
        </div>

        <div class="space-y-1.5 text-xs">
          <div class="flex justify-between py-1 border-b border-zinc-800/60">
            <span class="text-zinc-400" id="snap-lbl-zones">Domains</span>
            <span class="font-mono text-zinc-200 font-medium" id="snap-val-zones">0 zones</span>
          </div>
          <div class="flex justify-between py-1 border-b border-zinc-800/60">
            <span class="text-zinc-400" id="snap-lbl-records">DNS Records</span>
            <span class="font-mono text-zinc-200 font-medium" id="snap-val-records">0 records</span>
          </div>
          <div class="flex justify-between py-1 border-b border-zinc-800/60">
            <span class="text-zinc-400" id="snap-lbl-interval">Sync Interval</span>
            <span class="font-mono text-zinc-200 font-medium" id="snap-val-interval">300s</span>
          </div>
          <div class="flex justify-between py-1 border-b border-zinc-800/60">
            <span class="text-zinc-400" id="snap-lbl-nics">NIC Priority</span>
            <span class="font-mono text-zinc-200 font-medium text-right truncate max-w-[130px]" id="snap-val-nics">Default</span>
          </div>
          <div class="flex justify-between py-1 border-b border-zinc-800/60">
            <span class="text-zinc-400" id="snap-lbl-history">IP History</span>
            <span class="text-zinc-300 font-medium" id="snap-val-history">Enabled</span>
          </div>
          <div class="flex justify-between py-1">
            <span class="text-zinc-400" id="snap-lbl-autoupdate">Auto-Update</span>
            <span class="text-zinc-300 font-medium" id="snap-val-autoupdate">Disabled</span>
          </div>
        </div>
      </div>
    </aside>

    <!-- Right Column: Interactive Workspace (8 cols) -->
    <section class="lg:col-span-8 bg-zinc-900/50 border border-zinc-800/80 rounded-xl p-5 sm:p-7 backdrop-blur-md shadow-lg shadow-black/30 min-h-[500px] flex flex-col justify-between">
      
      <!-- Alert Message Banner -->
      <div id="alert-box" class="p-3.5 rounded-lg text-xs font-medium mb-5 flex items-center gap-2.5 hidden"></div>

      <!-- STEP 1: AUTH -->
      <div id="step-1" class="space-y-5">
        <div>
          <h2 class="text-lg sm:text-xl font-bold text-zinc-100" id="step1-title">Cloudflare Authentication</h2>
          <p class="text-xs sm:text-sm text-zinc-400 mt-0.5" id="step1-desc">Enter your Cloudflare API Token to discover and manage your DNS records.</p>
        </div>

        <div class="space-y-1.5">
          <label class="text-xs font-semibold text-zinc-300" id="lbl-token">API Token</label>
          <div class="relative">
            <input type="password" id="input-token" class="w-full px-3.5 py-2.5 bg-zinc-950 border border-zinc-800 rounded-lg text-zinc-100 placeholder-zinc-500 font-mono text-xs sm:text-sm focus:outline-none focus:border-rose-500 focus:ring-1 focus:ring-rose-500 transition-all pr-12" placeholder="Paste your API Token" />
            <button type="button" id="btn-toggle-token" class="absolute right-2.5 top-1/2 -translate-y-1/2 text-[11px] text-zinc-400 hover:text-zinc-200 px-2 py-0.5 rounded bg-zinc-900 border border-zinc-800 font-mono cursor-pointer">Show</button>
          </div>
        </div>

        <!-- Token permissions checklist helper -->
        <div class="p-3.5 bg-zinc-950/60 border border-zinc-800/80 rounded-lg space-y-2 text-xs">
          <span class="font-semibold text-zinc-300 block" id="step1-help-title">Required Permissions:</span>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-2 text-zinc-400">
            <div class="flex items-center gap-1.5">
              <svg class="w-3.5 h-3.5 text-emerald-400 flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M20 6 9 17l-5-5"/></svg>
              <span>Zone &gt; Zone &gt; Read</span>
            </div>
            <div class="flex items-center gap-1.5">
              <svg class="w-3.5 h-3.5 text-emerald-400 flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M20 6 9 17l-5-5"/></svg>
              <span>Zone &gt; DNS &gt; Edit</span>
            </div>
          </div>
        </div>

        <div class="flex justify-end pt-5 border-t border-zinc-800/80">
          <button class="px-5 py-2.5 rounded-lg bg-rose-600 hover:bg-rose-700 text-white font-medium text-xs sm:text-sm transition-all shadow-sm shadow-rose-950 flex items-center gap-2 cursor-pointer active:scale-[0.98]" id="btn-step1-next">
            <span id="btn-text-step1">Verify & Continue</span>
            <span id="btn-spin-step1" class="w-3.5 h-3.5 border-2 border-white/20 border-t-white rounded-full animate-spin hidden"></span>
          </button>
        </div>
      </div>

      <!-- STEP 2: ZONES SELECTION (GRID LAYOUT) -->
      <div id="step-2" class="space-y-5 hidden">
        <div>
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2">
            <div>
              <h2 class="text-lg sm:text-xl font-bold text-zinc-100" id="step2-title">Select Managed Zones</h2>
              <p class="text-xs sm:text-sm text-zinc-400 mt-0.5" id="step2-desc">Choose which domains c2go should keep updated.</p>
            </div>
            <button type="button" id="btn-select-all-zones" class="text-xs text-rose-400 hover:text-rose-300 font-semibold px-2.5 py-1 bg-rose-500/10 border border-rose-500/20 rounded-md self-start sm:self-auto cursor-pointer">Select All</button>
          </div>
        </div>

        <!-- Search Bar -->
        <div>
          <input type="text" id="zones-search" placeholder="Filter domains..." class="w-full px-3.5 py-2 bg-zinc-950 border border-zinc-800 rounded-lg text-zinc-100 text-xs sm:text-sm focus:outline-none focus:border-rose-500" />
        </div>

        <!-- 2-Column Domain Cards Grid -->
        <div id="zones-grid" class="grid grid-cols-1 sm:grid-cols-2 gap-2.5 max-h-[320px] overflow-y-auto pr-1"></div>

        <div class="flex justify-between items-center pt-5 border-t border-zinc-800/80">
          <button class="px-4 py-2 rounded-lg bg-zinc-800 hover:bg-zinc-700 text-zinc-200 font-medium text-xs sm:text-sm border border-zinc-700 cursor-pointer" id="btn-step2-back">Back</button>
          <button class="px-5 py-2.5 rounded-lg bg-rose-600 hover:bg-rose-700 text-white font-medium text-xs sm:text-sm transition-all shadow-sm shadow-rose-950 flex items-center gap-2 cursor-pointer active:scale-[0.98]" id="btn-step2-next">
            <span id="btn-text-step2">Configure Records</span>
            <span id="btn-spin-step2" class="w-3.5 h-3.5 border-2 border-white/20 border-t-white rounded-full animate-spin hidden"></span>
          </button>
        </div>
      </div>

      <!-- STEP 3: DNS RECORDS SELECTION & CREATION (GRID LAYOUT) -->
      <div id="step-3" class="space-y-5 hidden">
        <div>
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2">
            <div>
              <h2 class="text-lg sm:text-xl font-bold text-zinc-100" id="step3-title">DNS Records</h2>
              <p class="text-xs sm:text-sm text-zinc-400 mt-0.5" id="step3-desc">Select records to associate with your dynamic IP.</p>
            </div>
            <!-- Zone Switcher Badge / Tabs -->
            <div id="zone-tab-badge" class="px-2.5 py-0.5 bg-amber-500/10 border border-amber-500/30 text-amber-300 rounded-md text-xs font-mono font-semibold self-start sm:self-auto">Domain 1 of 1</div>
          </div>
        </div>

        <!-- 2-Column Records Cards Grid -->
        <div id="records-grid" class="grid grid-cols-1 sm:grid-cols-2 gap-2.5 max-h-[260px] overflow-y-auto pr-1"></div>

        <!-- Inline Record Creator Drawer -->
        <div class="p-3.5 bg-zinc-950/70 border border-dashed border-zinc-750 rounded-xl space-y-2.5">
          <span class="text-xs font-semibold text-zinc-300 block" id="lbl-create-record-title">Create New DNS A Record</span>
          <div class="grid grid-cols-1 sm:grid-cols-[1fr_auto_auto] gap-2 items-center">
            <input type="text" id="new-record-name" placeholder="subdomain (e.g. vpn or dev)" class="px-3 py-2 bg-zinc-900 border border-zinc-800 rounded-lg text-zinc-100 text-xs font-mono focus:outline-none focus:border-rose-500" />
            <label class="flex items-center gap-1.5 text-xs font-medium text-zinc-200 cursor-pointer select-none px-2.5 py-2 bg-zinc-900 rounded-lg border border-zinc-800">
              <input type="checkbox" id="new-record-proxied" class="w-3.5 h-3.5 rounded border-zinc-700 bg-zinc-950 text-rose-600 focus:ring-rose-500">
              <span>Proxy</span>
            </label>
            <button type="button" id="btn-add-record" class="px-3.5 py-2 rounded-lg bg-zinc-800 hover:bg-zinc-700 text-zinc-100 font-medium text-xs border border-zinc-700 cursor-pointer">Add</button>
          </div>
        </div>

        <div class="flex justify-between items-center pt-5 border-t border-zinc-800/80">
          <button class="px-4 py-2 rounded-lg bg-zinc-800 hover:bg-zinc-700 text-zinc-200 font-medium text-xs sm:text-sm border border-zinc-700 cursor-pointer" id="btn-step3-back">Back</button>
          <button class="px-5 py-2.5 rounded-lg bg-rose-600 hover:bg-rose-700 text-white font-medium text-xs sm:text-sm transition-all shadow-sm shadow-rose-950 cursor-pointer active:scale-[0.98]" id="btn-step3-next">
            <span id="btn-text-step3">Next Domain</span>
          </button>
        </div>
      </div>

      <!-- STEP 4: AUTOMATION & SETTINGS -->
      <div id="step-4" class="space-y-5 hidden">
        <div>
          <h2 class="text-lg sm:text-xl font-bold text-zinc-100" id="step4-title">Automation & Settings</h2>
          <p class="text-xs sm:text-sm text-zinc-400 mt-0.5" id="step4-desc">Configure backup check frequency and self-update preferences.</p>
        </div>

        <!-- Interval Options Grid -->
        <div class="space-y-2">
          <label class="text-xs font-semibold text-zinc-300 block" id="lbl-interval">Backup Check Interval</label>
          <div class="grid grid-cols-2 sm:grid-cols-4 gap-2">
            <button type="button" class="interval-chip px-3 py-2.5 rounded-lg border border-zinc-800 bg-zinc-950 text-zinc-300 font-mono text-xs sm:text-sm hover:border-zinc-700 cursor-pointer" data-val="60">60s (1m)</button>
            <button type="button" class="interval-chip active px-3 py-2.5 rounded-lg border border-rose-500 bg-rose-500/10 text-rose-300 font-mono text-xs sm:text-sm font-semibold cursor-pointer" data-val="300">300s (5m)</button>
            <button type="button" class="interval-chip px-3 py-2.5 rounded-lg border border-zinc-800 bg-zinc-950 text-zinc-300 font-mono text-xs sm:text-sm hover:border-zinc-700 cursor-pointer" data-val="600">600s (10m)</button>
            <button type="button" class="interval-chip px-3 py-2.5 rounded-lg border border-zinc-800 bg-zinc-950 text-zinc-300 font-mono text-xs sm:text-sm hover:border-zinc-700 cursor-pointer" data-val="1800">1800s (30m)</button>
          </div>
          <input type="hidden" id="input-interval" value="300" />
        </div>

        <!-- Feature Switches List -->
        <div class="space-y-2.5 pt-1">
          <div class="flex items-center justify-between p-3.5 bg-zinc-950/60 border border-zinc-800 rounded-xl">
            <div>
              <div class="text-xs sm:text-sm font-semibold text-zinc-100" id="lbl-history">IP Change History Logging</div>
              <div class="text-[11px] text-zinc-400 mt-0.5" id="lbl-history-desc">Stores records of external IP changes in history.json</div>
            </div>
            <label class="relative inline-flex items-center cursor-pointer">
              <input type="checkbox" id="input-history" checked class="sr-only peer">
              <div class="w-10 h-5 bg-zinc-800 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-zinc-300 after:border after:rounded-full after:h-4 after:w-4 after:transition-all peer-checked:bg-rose-600"></div>
            </label>
          </div>

          <div class="flex items-center justify-between p-3.5 bg-zinc-950/60 border border-zinc-800 rounded-xl">
            <div>
              <div class="text-xs sm:text-sm font-semibold text-zinc-100" id="lbl-updates">GitHub Release Notification</div>
              <div class="text-[11px] text-zinc-400 mt-0.5" id="lbl-updates-desc">Checks for new official releases in the background</div>
            </div>
            <label class="relative inline-flex items-center cursor-pointer">
              <input type="checkbox" id="input-updates" checked class="sr-only peer">
              <div class="w-10 h-5 bg-zinc-800 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-zinc-300 after:border after:rounded-full after:h-4 after:w-4 after:transition-all peer-checked:bg-rose-600"></div>
            </label>
          </div>

          <div class="flex items-center justify-between p-3.5 bg-zinc-950/60 border border-zinc-800 rounded-xl">
            <div>
              <div class="text-xs sm:text-sm font-semibold text-zinc-100" id="lbl-autoupdate">Automatic Self-Update</div>
              <div class="text-[11px] text-zinc-400 mt-0.5" id="lbl-autoupdate-desc">Installs validated releases directly without manual prompt</div>
            </div>
            <label class="relative inline-flex items-center cursor-pointer">
              <input type="checkbox" id="input-autoupdate" class="sr-only peer">
              <div class="w-10 h-5 bg-zinc-800 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-zinc-300 after:border after:rounded-full after:h-4 after:w-4 after:transition-all peer-checked:bg-rose-600"></div>
            </label>
          </div>

          <!-- Network Interfaces / Multi-NIC Priority -->
          <div class="pt-4 border-t border-zinc-800/80 space-y-3">
            <div>
              <div class="text-xs sm:text-sm font-semibold text-zinc-100 flex items-center justify-between">
                <span id="lbl-nics">Network Interfaces (Multi-NIC Priority)</span>
                <span class="text-[10px] font-mono text-zinc-400" id="lbl-nics-count">0 detected</span>
              </div>
              <div class="text-[11px] text-zinc-400 mt-0.5" id="lbl-nics-desc">
                Prioritize interfaces for IP detection. If the top interface goes down, c2go falls back automatically.
              </div>
            </div>

            <!-- Interactive NIC Priority List -->
            <div id="interfaces-list" class="space-y-2">
              <div class="text-xs text-zinc-500 py-3 text-center border border-zinc-800/60 rounded-lg">Scanning network interfaces...</div>
            </div>
          </div>
        </div>

        <div class="flex justify-between items-center pt-5 border-t border-zinc-800/80">
          <button class="px-4 py-2 rounded-lg bg-zinc-800 hover:bg-zinc-700 text-zinc-200 font-medium text-xs sm:text-sm border border-zinc-700 cursor-pointer" id="btn-step4-back">Back</button>
          <button class="px-5 py-2.5 rounded-lg bg-rose-600 hover:bg-rose-700 text-white font-medium text-xs sm:text-sm transition-all shadow-sm shadow-rose-950 cursor-pointer active:scale-[0.98]" id="btn-step4-next">Review Configuration</button>
        </div>
      </div>

      <!-- STEP 5: REVIEW & FINISH -->
      <div id="step-5" class="space-y-5 hidden">
        <div>
          <h2 class="text-lg sm:text-xl font-bold text-zinc-100" id="step5-title">Review & Deploy</h2>
          <p class="text-xs sm:text-sm text-zinc-400 mt-0.5" id="step5-desc">Confirm your settings before saving to system config and secure keyring.</p>
        </div>

        <div class="bg-zinc-950 border border-zinc-800 rounded-xl overflow-hidden divide-y divide-zinc-800/80 text-xs sm:text-sm">
          <div class="flex justify-between p-3.5 bg-zinc-900/30">
            <span class="text-zinc-400" id="rev-lbl-domains">Monitored Zones</span>
            <span class="font-mono font-medium text-zinc-100" id="rev-val-domains">0</span>
          </div>
          <div class="flex justify-between p-3.5 bg-zinc-900/30">
            <span class="text-zinc-400" id="rev-lbl-records">Total DNS Records</span>
            <span class="font-mono font-medium text-zinc-100" id="rev-val-records">0</span>
          </div>
          <div class="flex justify-between p-3.5 bg-zinc-900/30">
            <span class="text-zinc-400" id="rev-lbl-interval">Backup Check Interval</span>
            <span class="font-mono font-medium text-zinc-100" id="rev-val-interval">300s</span>
          </div>
          <div class="flex justify-between p-3.5 bg-zinc-900/30">
            <span class="text-zinc-400" id="rev-lbl-nics">NIC Routing Priority</span>
            <span class="font-mono font-medium text-zinc-100 text-right truncate max-w-[220px]" id="rev-val-nics">Default Routing</span>
          </div>
          <div class="flex justify-between p-3.5 bg-zinc-900/30">
            <span class="text-zinc-400" id="rev-lbl-history">IP Change History</span>
            <span class="font-medium text-zinc-100" id="rev-val-history">Enabled</span>
          </div>
          <div class="flex justify-between p-3.5 bg-zinc-900/30">
            <span class="text-zinc-400" id="rev-lbl-autoupdate">Self-Update</span>
            <span class="font-medium text-zinc-100" id="rev-val-autoupdate">Disabled</span>
          </div>
        </div>

        <div class="flex justify-between items-center pt-5 border-t border-zinc-800/80">
          <button class="px-4 py-2 rounded-lg bg-zinc-800 hover:bg-zinc-700 text-zinc-200 font-medium text-xs sm:text-sm border border-zinc-700 cursor-pointer" id="btn-step5-back">Back</button>
          <button class="px-6 py-2.5 rounded-lg bg-rose-600 hover:bg-rose-700 text-white font-semibold text-xs sm:text-sm transition-all shadow-md shadow-rose-950 flex items-center gap-2 cursor-pointer active:scale-[0.98]" id="btn-save-final">
            <span id="btn-text-save">Save & Finish Setup</span>
            <span id="btn-spin-save" class="w-3.5 h-3.5 border-2 border-white/20 border-t-white rounded-full animate-spin hidden"></span>
          </button>
        </div>
      </div>

      <!-- SUCCESS SCREEN (SERVICE AWARE) -->
      <div id="step-success" class="space-y-6 py-4 hidden">
        <div class="flex items-center gap-3">
          <div class="w-10 h-10 rounded-xl bg-emerald-500/15 border border-emerald-500/30 text-emerald-400 flex items-center justify-center flex-shrink-0">
            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M20 6 9 17l-5-5"/></svg>
          </div>
          <div>
            <h2 class="text-lg sm:text-xl font-bold text-zinc-100" id="lbl-success-title">Configuration Saved Successfully!</h2>
            <p class="text-xs text-zinc-400 mt-0.5" id="lbl-success-desc">Credentials stored in system keyring and configuration saved to config.json</p>
          </div>
        </div>

        <!-- Service & Execution Status Card -->
        <div class="p-4 bg-zinc-950 border border-zinc-800 rounded-xl space-y-3.5">
          <div class="flex items-center justify-between">
            <span class="text-xs font-semibold text-zinc-300" id="lbl-how-to-start">Service / Process Status:</span>
            <div id="service-status-pill" class="flex items-center gap-1.5 px-2.5 py-0.5 rounded text-[11px] font-mono font-medium bg-zinc-800 text-zinc-400 border border-zinc-700">
              <span class="w-1.5 h-1.5 rounded-full bg-zinc-500"></span>
              <span id="service-pill-text">Detecting status...</span>
            </div>
          </div>

          <!-- Command Box with One-Click Copy -->
          <div class="space-y-1.5">
            <div class="text-[11px] text-zinc-400 font-medium" id="lbl-cmd-title">Command to start or restart:</div>
            <div class="flex items-center justify-between p-3 bg-zinc-900 rounded-lg border border-zinc-800">
              <code class="text-xs sm:text-sm font-mono text-zinc-200" id="cmd-to-run">./c2go</code>
              <button type="button" id="btn-copy-cmd" class="px-2.5 py-1 text-xs font-medium rounded bg-zinc-800 hover:bg-zinc-700 text-zinc-200 border border-zinc-700 flex items-center gap-1.5 transition-all cursor-pointer active:scale-95">
                <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="14" height="14" x="8" y="8" rx="2" ry="2"/><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/></svg>
                <span id="btn-copy-text">Copy</span>
              </button>
            </div>
          </div>

          <!-- Contextual note -->
          <p class="text-xs text-zinc-400 leading-relaxed" id="os-help-note">
            Run the command in your terminal to start real-time dynamic DNS synchronization.
          </p>
        </div>

        <div class="flex justify-end pt-4 border-t border-zinc-800/80">
          <div class="text-xs text-zinc-500 font-mono">Setup completed. Press Ctrl+C in terminal to exit server.</div>
        </div>
      </div>

    </section>
  </main>
</Layout>

<script>
  import { translations } from '../lib/i18n';
  import type { CloudflareZone, DNSRecord, ConfigPayload, NetworkInterface, ServiceStatusInfo } from '../lib/types';

  let currentLang: 'en' | 'es' = 'en';
  let availableZones: CloudflareZone[] = [];
  let selectedZones: CloudflareZone[] = [];
  let zoneRecordMap: Record<string, { records: DNSRecord[]; selected: Set<string> }> = {};
  let currentZoneIndex = 0;
  let currentPublicIP = '';
  let detectedInterfaces: NetworkInterface[] = [];
  let preferredInterfaces: string[] = [];
  let serviceStatus: ServiceStatusInfo | null = null;

  function switchLanguage(lang: 'en' | 'es') {
    currentLang = lang;
    const t = translations[lang] || translations.en;
    
    // Update labels and navigation
    const setTxt = (id: string, text: string) => {
      const el = document.getElementById(id);
      if (el) el.innerText = text;
    };

    setTxt('nav-lbl-1', t.step1);
    setTxt('nav-lbl-2', t.step2);
    setTxt('nav-lbl-3', t.step3);
    setTxt('nav-lbl-4', t.step4);
    setTxt('nav-lbl-5', t.step5);
    setTxt('lbl-token', t.token_label);
    setTxt('btn-text-step1', t.verify_continue);
    setTxt('step2-title', t.select_zones);
    setTxt('step2-desc', t.select_zones_desc);
    setTxt('step3-title', t.select_records);
    setTxt('step3-desc', t.select_records_desc);
    setTxt('lbl-create-record-title', t.create_record_title);
    setTxt('btn-add-record', t.add_record);
    setTxt('lbl-interval', t.interval);
    setTxt('lbl-history', t.history);
    setTxt('lbl-history-desc', t.history_desc);
    setTxt('lbl-updates', t.updates);
    setTxt('lbl-updates-desc', t.updates_desc);
    setTxt('lbl-autoupdate', t.autoupdate);
    setTxt('lbl-autoupdate-desc', t.autoupdate_desc);
    setTxt('lbl-nics', t.network_interfaces || 'Network Interfaces (Multi-NIC Priority)');
    setTxt('lbl-nics-desc', t.network_interfaces_desc || 'Prioritize interfaces for IP detection. If the top interface goes down, c2go falls back automatically.');
    setTxt('btn-text-save', t.save_finish);
    setTxt('lbl-success-title', t.success_title);
    setTxt('lbl-success-desc', t.success_desc);
    updateServiceStatus();
    renderInterfacesList();
    updateSummary();
  }

  function showAlert(msg: string, isError = true) {
    const box = document.getElementById('alert-box');
    if (!box) return;
    box.className = `p-3.5 rounded-lg text-xs font-medium mb-5 flex items-center gap-2.5 ${
      isError ? 'bg-red-500/10 text-red-400 border border-red-500/20' : 'bg-emerald-500/10 text-emerald-400 border border-emerald-500/20'
    }`;
    box.innerText = msg;
    box.classList.remove('hidden');
  }

  function hideAlert() {
    const box = document.getElementById('alert-box');
    if (box) box.classList.add('hidden');
  }

  function goToStep(num: number) {
    hideAlert();
    for (let i = 1; i <= 5; i++) {
      const el = document.getElementById(`step-${i}`);
      const nav = document.getElementById(`nav-step-${i}`);
      if (el) el.classList.add('hidden');
      if (nav) {
        nav.classList.remove('active');
        const icon = nav.querySelector('.step-nav-icon');
        if (i < num) {
          nav.classList.add('completed');
          if (icon) {
            icon.className = 'step-nav-icon w-6 h-6 rounded-md bg-emerald-500/20 text-emerald-400 border border-emerald-500/40 flex items-center justify-center text-xs font-bold flex-shrink-0 mt-0.5';
            icon.innerHTML = '<svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="M20 6 9 17l-5-5"/></svg>';
          }
        } else if (i === num) {
          nav.classList.add('active');
          if (icon) {
            icon.className = 'step-nav-icon w-6 h-6 rounded-md bg-rose-600 text-white flex items-center justify-center text-xs font-bold flex-shrink-0 mt-0.5 shadow-sm shadow-rose-950';
            icon.innerText = i.toString();
          }
        } else {
          nav.classList.remove('completed');
          if (icon) {
            icon.className = 'step-nav-icon w-6 h-6 rounded-md bg-zinc-800 text-zinc-400 border border-zinc-700 flex items-center justify-center text-xs font-bold flex-shrink-0 mt-0.5';
            icon.innerText = i.toString();
          }
        }
      }
    }
    const target = document.getElementById(`step-${num}`);
    if (target) target.classList.remove('hidden');
    updateSummary();
  }

  function updateServiceStatus() {
    const pill = document.getElementById('service-status-pill');
    const pillText = document.getElementById('service-pill-text');
    const cmdEl = document.getElementById('cmd-to-run');
    const noteEl = document.getElementById('os-help-note');
    const cmdTitle = document.getElementById('lbl-cmd-title');

    if (!serviceStatus) {
      if (pillText) pillText.innerText = 'Standalone CLI';
      if (cmdEl) cmdEl.innerText = './c2go';
      return;
    }

    if (cmdEl && serviceStatus.suggested_cmd) {
      cmdEl.innerText = serviceStatus.suggested_cmd;
    }

    if (noteEl && serviceStatus.action_note) {
      noteEl.innerText = serviceStatus.action_note;
    }

    if (cmdTitle) {
      cmdTitle.innerText = serviceStatus.is_running
        ? (currentLang === 'es' ? 'Comando para reiniciar el servicio:' : 'Command to restart the service:')
        : (currentLang === 'es' ? 'Comando para iniciar c2go:' : 'Command to start c2go:');
    }

    if (pill) {
      if (serviceStatus.is_running) {
        pill.className = 'flex items-center gap-1.5 px-2.5 py-0.5 rounded text-[11px] font-mono font-medium bg-emerald-500/15 text-emerald-300 border border-emerald-500/30';
        pill.innerHTML = `<span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span><span>${serviceStatus.status_label}</span>`;
      } else if (serviceStatus.is_installed) {
        pill.className = 'flex items-center gap-1.5 px-2.5 py-0.5 rounded text-[11px] font-mono font-medium bg-amber-500/15 text-amber-300 border border-amber-500/30';
        pill.innerHTML = `<span class="w-1.5 h-1.5 rounded-full bg-amber-400"></span><span>${serviceStatus.status_label}</span>`;
      } else {
        pill.className = 'flex items-center gap-1.5 px-2.5 py-0.5 rounded text-[11px] font-mono font-medium bg-zinc-800 text-zinc-300 border border-zinc-700';
        pill.innerHTML = `<span class="w-1.5 h-1.5 rounded-full bg-zinc-400"></span><span>${serviceStatus.status_label}</span>`;
      }
    }
  }

  function renderInterfacesList() {
    const container = document.getElementById('interfaces-list');
    const countEl = document.getElementById('lbl-nics-count');
    if (!container) return;
    if (countEl) countEl.innerText = `${detectedInterfaces.length} detected`;

    if (!detectedInterfaces || detectedInterfaces.length === 0) {
      container.innerHTML = `<div class="text-xs text-zinc-500 py-3 text-center border border-zinc-800/60 rounded-lg">No physical network interfaces found. Using system default routing.</div>`;
      return;
    }

    // Build list: first items in preferredInterfaces in order, then the remaining detected interfaces
    const orderedList: { iface: NetworkInterface; isSelected: boolean; priority: number }[] = [];
    
    preferredInterfaces.forEach((name, idx) => {
      const found = detectedInterfaces.find(i => i.name === name);
      if (found) {
        orderedList.push({ iface: found, isSelected: true, priority: idx + 1 });
      } else {
        orderedList.push({ iface: { name, up: false, ips: [], mac: '' }, isSelected: true, priority: idx + 1 });
      }
    });

    detectedInterfaces.forEach(i => {
      if (!preferredInterfaces.includes(i.name)) {
        orderedList.push({ iface: i, isSelected: false, priority: 0 });
      }
    });

    container.innerHTML = '';

    orderedList.forEach((item, index) => {
      const { iface, isSelected, priority } = item;
      const isFirst = isSelected && priority === 1;
      const isLastSelected = isSelected && priority === preferredInterfaces.length;

      const card = document.createElement('div');
      card.className = `p-3 rounded-lg border transition-all duration-150 flex items-center justify-between gap-3 ${
        isSelected
          ? 'bg-zinc-900/90 border-rose-500/50 shadow-sm shadow-rose-950/20'
          : 'bg-zinc-950/60 border-zinc-800/80 opacity-70 hover:opacity-100 hover:border-zinc-700'
      }`;

      const ipsText = iface.ips && iface.ips.length > 0 ? iface.ips.join(', ') : 'No IP assigned';

      card.innerHTML = `
        <div class="flex items-center gap-3 min-w-0">
          <button type="button" class="nic-toggle-btn w-5 h-5 rounded border flex items-center justify-center transition-colors flex-shrink-0 cursor-pointer ${
            isSelected ? 'bg-rose-600 border-rose-600 text-white' : 'border-zinc-700 bg-zinc-900 hover:border-zinc-500'
          }" data-name="${iface.name}">
            ${isSelected ? '<svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="M20 6 9 17l-5-5"/></svg>' : ''}
          </button>

          <div class="min-w-0 space-y-0.5">
            <div class="flex items-center gap-2">
              <span class="font-mono font-semibold text-xs sm:text-sm text-zinc-100">${iface.name}</span>
              <span class="px-1.5 py-0.2 rounded text-[10px] font-mono border flex-shrink-0 ${
                iface.up ? 'bg-emerald-500/15 text-emerald-300 border-emerald-500/30' : 'bg-zinc-800 text-zinc-500 border-zinc-700'
              }">${iface.up ? 'UP / ACTIVE' : 'DOWN'}</span>
              ${isSelected ? `
                <span class="px-1.5 py-0.2 rounded text-[10px] font-mono font-semibold bg-rose-500/20 text-rose-300 border border-rose-500/30">
                  #${priority} ${priority === 1 ? '(Primary)' : ''}
                </span>
              ` : '<span class="text-[10px] text-zinc-500 font-mono">(Excluded)</span>'}
            </div>
            <div class="text-[11px] font-mono text-zinc-400 truncate flex items-center gap-2">
              <span class="text-zinc-300">${ipsText}</span>
              ${iface.mac ? `<span class="text-zinc-600 text-[10px]">MAC: ${iface.mac}</span>` : ''}
            </div>
          </div>
        </div>

        <div class="flex items-center gap-1 flex-shrink-0">
          ${isSelected ? `
            <button type="button" class="btn-nic-up p-1.5 rounded bg-zinc-800 hover:bg-zinc-700 text-zinc-300 hover:text-white border border-zinc-700 disabled:opacity-30 disabled:cursor-not-allowed transition-all cursor-pointer" data-name="${iface.name}" ${isFirst ? 'disabled' : ''} title="Move Up (Higher Priority)">
              <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="m18 15-6-6-6 6"/></svg>
            </button>
            <button type="button" class="btn-nic-down p-1.5 rounded bg-zinc-800 hover:bg-zinc-700 text-zinc-300 hover:text-white border border-zinc-700 disabled:opacity-30 disabled:cursor-not-allowed transition-all cursor-pointer" data-name="${iface.name}" ${isLastSelected ? 'disabled' : ''} title="Move Down (Lower Priority)">
              <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="m6 9 6 6 6-6"/></svg>
            </button>
          ` : `
            <button type="button" class="btn-nic-add px-2 py-1 rounded bg-zinc-800 hover:bg-zinc-700 text-zinc-300 text-xs font-medium border border-zinc-700 transition-all cursor-pointer" data-name="${iface.name}">
              + Prioritize
            </button>
          `}
        </div>
      `;

      container.appendChild(card);
    });

    // Bind event listeners for NIC controls
    container.querySelectorAll('.nic-toggle-btn, .btn-nic-add').forEach(el => {
      el.addEventListener('click', (e) => {
        const target = e.currentTarget as HTMLElement;
        const name = target.getAttribute('data-name');
        if (!name) return;
        if (preferredInterfaces.includes(name)) {
          preferredInterfaces = preferredInterfaces.filter(n => n !== name);
        } else {
          preferredInterfaces.push(name);
        }
        renderInterfacesList();
        updateSummary();
      });
    });

    container.querySelectorAll('.btn-nic-up').forEach(el => {
      el.addEventListener('click', (e) => {
        const target = e.currentTarget as HTMLElement;
        const name = target.getAttribute('data-name');
        if (!name) return;
        const idx = preferredInterfaces.indexOf(name);
        if (idx > 0) {
          const temp = preferredInterfaces[idx - 1];
          preferredInterfaces[idx - 1] = preferredInterfaces[idx];
          preferredInterfaces[idx] = temp;
          renderInterfacesList();
          updateSummary();
        }
      });
    });

    container.querySelectorAll('.btn-nic-down').forEach(el => {
      el.addEventListener('click', (e) => {
        const target = e.currentTarget as HTMLElement;
        const name = target.getAttribute('data-name');
        if (!name) return;
        const idx = preferredInterfaces.indexOf(name);
        if (idx >= 0 && idx < preferredInterfaces.length - 1) {
          const temp = preferredInterfaces[idx + 1];
          preferredInterfaces[idx + 1] = preferredInterfaces[idx];
          preferredInterfaces[idx] = temp;
          renderInterfacesList();
          updateSummary();
        }
      });
    });
  }

  async function loadInitial() {
    try {
      const res = await fetch('/api/initial-data');
      if (res.ok) {
        const data = await res.json();
        if (data.service_status) serviceStatus = data.service_status;
        if (data.network_interfaces) detectedInterfaces = data.network_interfaces;
        if (data.preferred_interfaces) preferredInterfaces = data.preferred_interfaces;

        if (data.language) {
          const langSelect = document.getElementById('input-lang') as HTMLSelectElement;
          if (langSelect) langSelect.value = data.language;
          switchLanguage(data.language);
        }
        if (data.token) {
          const tokenInput = document.getElementById('input-token') as HTMLInputElement;
          if (tokenInput) tokenInput.value = data.token;
        }
        if (data.update_interval) {
          const intervalInput = document.getElementById('input-interval') as HTMLInputElement;
          if (intervalInput) intervalInput.value = data.update_interval;
          document.querySelectorAll('.interval-chip').forEach(chip => {
            if (chip.getAttribute('data-val') === data.update_interval.toString()) {
              document.querySelectorAll('.interval-chip').forEach(c => c.className = 'interval-chip px-3 py-2.5 rounded-lg border border-zinc-800 bg-zinc-950 text-zinc-300 font-mono text-xs sm:text-sm hover:border-zinc-700 cursor-pointer');
              chip.className = 'interval-chip active px-3 py-2.5 rounded-lg border border-rose-500 bg-rose-500/10 text-rose-300 font-mono text-xs sm:text-sm font-semibold cursor-pointer';
            }
          });
        }
        if (data.history_enabled !== undefined) {
          const histInput = document.getElementById('input-history') as HTMLInputElement;
          if (histInput) histInput.checked = data.history_enabled;
        }
        if (data.check_updates !== undefined) {
          const updateInput = document.getElementById('input-updates') as HTMLInputElement;
          if (updateInput) updateInput.checked = data.check_updates;
        }
        if (data.auto_update !== undefined) {
          const autoInput = document.getElementById('input-autoupdate') as HTMLInputElement;
          if (autoInput) autoInput.checked = data.auto_update;
        }
        if (data.public_ip) {
          currentPublicIP = data.public_ip;
          const ipVal = document.getElementById('top-ip-val');
          if (ipVal) ipVal.innerText = currentPublicIP;
        }
        updateServiceStatus();
        renderInterfacesList();
        updateSummary();
      }
    } catch (e) {
      console.warn('Initial data warning:', e);
    }
  }

  async function validateStep1() {
    const tokenInput = document.getElementById('input-token') as HTMLInputElement;
    const token = tokenInput ? tokenInput.value.trim() : '';
    const t = translations[currentLang] || translations.en;

    if (!token) {
      showAlert(`${t.token_label} is required.`);
      return;
    }

    const spin = document.getElementById('btn-spin-step1');
    const text = document.getElementById('btn-text-step1');
    if (spin) spin.classList.remove('hidden');
    if (text) text.classList.add('hidden');
    hideAlert();

    try {
      const res = await fetch('/api/verify-token', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ token })
      });
      const data = await res.json();
      if (!res.ok || !data.success) {
        throw new Error(data.error || t.token_invalid);
      }

      availableZones = (data.zones || []).map((z: any) => {
        if (typeof z === 'string') return { name: z };
        return { name: z.name || z.id || '' };
      }).filter((z: CloudflareZone) => z.name !== '');

      if (data.public_ip) {
        currentPublicIP = data.public_ip;
        const ipVal = document.getElementById('top-ip-val');
        if (ipVal) ipVal.innerText = currentPublicIP;
      }
      renderZonesGrid();
      goToStep(2);
    } catch (err: any) {
      showAlert(err.message);
    } finally {
      if (spin) spin.classList.add('hidden');
      if (text) text.classList.remove('hidden');
    }
  }

  function renderZonesGrid(filter = '') {
    const container = document.getElementById('zones-grid');
    if (!container) return;
    container.innerHTML = '';

    const filtered = availableZones.filter(z => z.name.toLowerCase().includes(filter.toLowerCase()));

    filtered.forEach(zone => {
      const isSelected = selectedZones.some(z => z.name === zone.name);
      const div = document.createElement('div');
      div.className = `flex items-center justify-between p-3.5 bg-zinc-950 border rounded-lg cursor-pointer transition-all duration-150 ${
        isSelected ? 'border-rose-500 bg-rose-500/10 shadow-sm shadow-rose-950/40 ring-1 ring-rose-500/50' : 'border-zinc-800 hover:border-zinc-700 hover:bg-zinc-900'
      }`;
      div.onclick = () => {
        const idx = selectedZones.findIndex(z => z.name === zone.name);
        if (idx >= 0) selectedZones.splice(idx, 1);
        else selectedZones.push(zone);
        renderZonesGrid(filter);
        updateSummary();
      };
      div.innerHTML = `
        <div class="pr-2 truncate">
          <div class="font-semibold text-xs sm:text-sm text-zinc-100 tracking-tight truncate">${zone.name}</div>
          <div class="text-[10px] text-zinc-400 font-mono mt-0.5 flex items-center gap-1.5">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
            Cloudflare Zone
          </div>
        </div>
        <div class="w-4 h-4 rounded border flex items-center justify-center transition-colors flex-shrink-0 ${
          isSelected ? 'bg-rose-600 border-rose-600' : 'border-zinc-700 bg-zinc-900'
        }">
          ${isSelected ? '<svg class="w-3 h-3 text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="M20 6 9 17l-5-5"/></svg>' : ''}
        </div>
      `;
      container.appendChild(div);
    });
  }

  async function loadRecordsForZone(index: number) {
    const zone = selectedZones[index];
    const t = translations[currentLang] || translations.en;
    const badge = document.getElementById('zone-tab-badge');
    if (badge) badge.innerText = `${zone.name} [${index + 1}/${selectedZones.length}]`;

    const nextBtnText = document.getElementById('btn-text-step3');
    if (nextBtnText) {
      nextBtnText.innerText = index === selectedZones.length - 1 ? t.finish_records : t.next_domain;
    }

    if (!zoneRecordMap[zone.name]) {
      try {
        const tokenInput = document.getElementById('input-token') as HTMLInputElement;
        const token = tokenInput ? tokenInput.value.trim() : '';
        const res = await fetch(`/api/zones/${encodeURIComponent(zone.name)}/records?token=${encodeURIComponent(token)}`);
        const data = await res.json();
        zoneRecordMap[zone.name] = {
          records: data.records || [],
          selected: new Set((data.records || []).map((r: any) => r.id))
        };
      } catch (e) {
        zoneRecordMap[zone.name] = { records: [], selected: new Set() };
      }
    }
    renderRecordsGrid(zone.name);
  }

  function renderRecordsGrid(domain: string) {
    const container = document.getElementById('records-grid');
    if (!container) return;
    container.innerHTML = '';
    const state = zoneRecordMap[domain];

    if (!state || !state.records || state.records.length === 0) {
      container.innerHTML = '<div class="col-span-2 text-xs text-zinc-500 py-6 text-center">No existing A records found. Create one below:</div>';
      return;
    }

    state.records.forEach(rec => {
      const isSelected = state.selected.has(rec.id);
      const isMatch = currentPublicIP !== '' && rec.content === currentPublicIP;
      const ipLabel = rec.content ? rec.content : 'Unassigned';

      const div = document.createElement('div');
      div.className = `flex items-center justify-between p-3.5 bg-zinc-950 border rounded-lg cursor-pointer transition-all duration-150 ${
        isSelected ? 'border-rose-500 bg-rose-500/10 shadow-sm shadow-rose-950/40 ring-1 ring-rose-500/50' : 'border-zinc-800 hover:border-zinc-700 hover:bg-zinc-900'
      }`;
      div.onclick = () => {
        if (state.selected.has(rec.id)) state.selected.delete(rec.id);
        else state.selected.add(rec.id);
        renderRecordsGrid(domain);
        updateSummary();
      };
      div.innerHTML = `
        <div class="pr-2 truncate space-y-1">
          <div class="font-semibold text-xs sm:text-sm text-zinc-100 flex items-center gap-2 truncate">
            <span class="truncate">${rec.name}</span>
            <span class="px-1.5 py-0.5 rounded text-[10px] font-mono border flex-shrink-0 ${
              rec.proxied ? 'bg-amber-500/15 text-amber-300 border-amber-500/30' : 'bg-zinc-800 text-zinc-400 border-zinc-700'
            }">${rec.proxied ? 'Proxied' : 'DNS'}</span>
            ${isMatch ? '<span class="px-1.5 py-0.5 rounded text-[10px] font-mono border bg-emerald-500/15 text-emerald-300 border-emerald-500/30 flex items-center gap-1 flex-shrink-0"><span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>Current IP</span>' : ''}
          </div>
          <div class="text-[11px] font-mono flex items-center gap-1.5 ${isMatch ? 'text-emerald-400 font-semibold' : 'text-zinc-400'}">
            <span>IP:</span>
            <span>${ipLabel}</span>
            ${!isMatch && currentPublicIP && rec.content ? `<span class="text-[10px] text-amber-400/90 font-sans font-normal">&#8594; will update</span>` : ''}
          </div>
        </div>
        <div class="w-4 h-4 rounded border flex items-center justify-center transition-colors flex-shrink-0 ${
          isSelected ? 'bg-rose-600 border-rose-600' : 'border-zinc-700 bg-zinc-900'
        }">
          ${isSelected ? '<svg class="w-3 h-3 text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="M20 6 9 17l-5-5"/></svg>' : ''}
        </div>
      `;
      container.appendChild(div);
    });
  }

  async function createNewRecord() {
    const zone = selectedZones[currentZoneIndex];
    const hostInput = document.getElementById('new-record-name') as HTMLInputElement;
    const proxiedInput = document.getElementById('new-record-proxied') as HTMLInputElement;
    const name = hostInput ? hostInput.value.trim() : '';
    if (!name) return;

    const fullName = name.includes('.') ? name : `${name}.${zone.name}`;
    const tokenInput = document.getElementById('input-token') as HTMLInputElement;
    const token = tokenInput ? tokenInput.value.trim() : '';

    try {
      const res = await fetch(`/api/zones/${encodeURIComponent(zone.name)}/records`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          token,
          name: fullName,
          proxied: proxiedInput.checked,
          content: currentPublicIP || '1.1.1.1'
        })
      });
      const data = await res.json();
      if (!res.ok || !data.success) {
        throw new Error(data.error || 'Failed to create record');
      }

      const state = zoneRecordMap[zone.name];
      state.records.push(data.record);
      state.selected.add(data.record.id);
      hostInput.value = '';
      renderRecordsGrid(zone.name);
      updateSummary();
    } catch (err: any) {
      showAlert(err.message);
    }
  }

  function updateSummary() {
    const t = translations[currentLang] || translations.en;
    let totalRecords = 0;
    selectedZones.forEach(z => {
      const s = zoneRecordMap[z.name];
      if (s) totalRecords += s.selected.size;
    });

    const setTxt = (id: string, text: string) => {
      const el = document.getElementById(id);
      if (el) el.innerText = text;
    };

    const intervalVal = (document.getElementById('input-interval') as HTMLInputElement)?.value || '300';
    const histChecked = (document.getElementById('input-history') as HTMLInputElement)?.checked ?? true;
    const autoChecked = (document.getElementById('input-autoupdate') as HTMLInputElement)?.checked ?? false;

    // Snapshot widget
    setTxt('snap-val-zones', `${selectedZones.length} ${selectedZones.length === 1 ? 'zone' : 'zones'}`);
    setTxt('snap-val-records', `${totalRecords} ${totalRecords === 1 ? 'record' : 'records'}`);
    setTxt('snap-val-interval', `${intervalVal}s`);
    setTxt('snap-val-nics', preferredInterfaces.length > 0 ? preferredInterfaces.join(', ') : (t.default_routing || 'Default'));
    setTxt('snap-val-history', histChecked ? t.enabled : t.disabled);
    setTxt('snap-val-autoupdate', autoChecked ? t.enabled : t.disabled);

    // Review step table
    setTxt('rev-val-domains', selectedZones.length.toString());
    setTxt('rev-val-records', totalRecords.toString());
    setTxt('rev-val-interval', `${intervalVal}s`);
    setTxt('rev-val-nics', preferredInterfaces.length > 0 ? preferredInterfaces.map((nic, idx) => `#${idx+1}: ${nic}`).join(' → ') : (t.default_routing || 'Default Routing'));
    setTxt('rev-val-history', histChecked ? t.enabled : t.disabled);
    setTxt('rev-val-autoupdate', autoChecked ? t.enabled : t.disabled);
  }

  async function saveConfiguration() {
    const t = translations[currentLang] || translations.en;
    const tokenInput = document.getElementById('input-token') as HTMLInputElement;
    const intervalInput = document.getElementById('input-interval') as HTMLInputElement;
    const histInput = document.getElementById('input-history') as HTMLInputElement;
    const updatesInput = document.getElementById('input-updates') as HTMLInputElement;
    const autoInput = document.getElementById('input-autoupdate') as HTMLInputElement;

    const managedZones = selectedZones.map(zone => {
      const state = zoneRecordMap[zone.name];
      const selectedRecs = (state ? state.records : []).filter(r => state && state.selected.has(r.id)).map(r => ({
        id: r.id,
        name: r.name,
        type: 'A',
        proxied: r.proxied
      }));
      return {
        domain: zone.name,
        records: selectedRecs
      };
    });

    const payload: ConfigPayload = {
      token: tokenInput ? tokenInput.value.trim() : '',
      language: currentLang,
      update_interval: parseInt(intervalInput ? intervalInput.value : '300') || 300,
      history_enabled: histInput ? histInput.checked : true,
      check_updates: updatesInput ? updatesInput.checked : true,
      auto_update: autoInput ? autoInput.checked : false,
      preferred_interfaces: preferredInterfaces,
      managed_zones: managedZones
    };

    const spin = document.getElementById('btn-spin-save');
    const text = document.getElementById('btn-text-save');
    if (spin) spin.classList.remove('hidden');
    if (text) text.classList.add('hidden');
    hideAlert();

    try {
      const res = await fetch('/api/save-config', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload)
      });
      const data = await res.json();
      if (!res.ok || !data.success) {
        throw new Error(data.error || 'Failed to save configuration');
      }

      for (let i = 1; i <= 5; i++) {
        const el = document.getElementById(`step-${i}`);
        if (el) el.classList.add('hidden');
        const nav = document.getElementById(`nav-step-${i}`);
        if (nav) {
          nav.classList.remove('active');
          nav.classList.add('completed');
          const icon = nav.querySelector('.step-nav-icon');
          if (icon) {
            icon.className = 'step-nav-icon w-6 h-6 rounded-md bg-emerald-500/20 text-emerald-400 border border-emerald-500/40 flex items-center justify-center text-xs font-bold flex-shrink-0 mt-0.5';
            icon.innerHTML = '<svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="M20 6 9 17l-5-5"/></svg>';
          }
        }
      }
      const successEl = document.getElementById('step-success');
      if (successEl) successEl.classList.remove('hidden');
      updateServiceStatus();
    } catch (err: any) {
      showAlert(err.message);
    } finally {
      if (spin) spin.classList.add('hidden');
      if (text) text.classList.remove('hidden');
    }
  }

  // Event Listeners
  document.addEventListener('DOMContentLoaded', () => {
    const langSelect = document.getElementById('input-lang') as HTMLSelectElement;
    if (langSelect) {
      langSelect.addEventListener('change', (e) => {
        switchLanguage((e.target as HTMLSelectElement).value as 'en' | 'es');
      });
    }

    document.getElementById('btn-toggle-token')?.addEventListener('click', () => {
      const input = document.getElementById('input-token') as HTMLInputElement;
      const btn = document.getElementById('btn-toggle-token');
      if (input && btn) {
        if (input.type === 'password') {
          input.type = 'text';
          btn.innerText = 'Hide';
        } else {
          input.type = 'password';
          btn.innerText = 'Show';
        }
      }
    });

    document.getElementById('zones-search')?.addEventListener('input', (e) => {
      renderZonesGrid((e.target as HTMLInputElement).value);
    });

    document.getElementById('btn-select-all-zones')?.addEventListener('click', () => {
      if (selectedZones.length === availableZones.length) {
        selectedZones = [];
      } else {
        selectedZones = [...availableZones];
      }
      renderZonesGrid((document.getElementById('zones-search') as HTMLInputElement)?.value || '');
      updateSummary();
    });

    document.querySelectorAll('.interval-chip').forEach(chip => {
      chip.addEventListener('click', () => {
        const val = chip.getAttribute('data-val');
        if (val) {
          const input = document.getElementById('input-interval') as HTMLInputElement;
          if (input) input.value = val;
          document.querySelectorAll('.interval-chip').forEach(c => c.className = 'interval-chip px-3 py-2.5 rounded-lg border border-zinc-800 bg-zinc-950 text-zinc-300 font-mono text-xs sm:text-sm hover:border-zinc-700 cursor-pointer');
          chip.className = 'interval-chip active px-3 py-2.5 rounded-lg border border-rose-500 bg-rose-500/10 text-rose-300 font-mono text-xs sm:text-sm font-semibold cursor-pointer';
          updateSummary();
        }
      });
    });

    document.getElementById('input-history')?.addEventListener('change', updateSummary);
    document.getElementById('input-autoupdate')?.addEventListener('change', updateSummary);

    document.getElementById('btn-step1-next')?.addEventListener('click', validateStep1);
    document.getElementById('btn-step2-back')?.addEventListener('click', () => goToStep(1));
    document.getElementById('btn-step2-next')?.addEventListener('click', async () => {
      const t = translations[currentLang] || translations.en;
      if (selectedZones.length === 0) {
        showAlert(t.must_select_zone);
        return;
      }
      currentZoneIndex = 0;
      await loadRecordsForZone(currentZoneIndex);
      goToStep(3);
    });

    document.getElementById('btn-step3-back')?.addEventListener('click', () => {
      if (currentZoneIndex > 0) {
        currentZoneIndex--;
        loadRecordsForZone(currentZoneIndex);
      } else {
        goToStep(2);
      }
    });

    document.getElementById('btn-step3-next')?.addEventListener('click', () => {
      const zone = selectedZones[currentZoneIndex];
      const state = zoneRecordMap[zone.name];
      const t = translations[currentLang] || translations.en;
      if (!state.selected || state.selected.size === 0) {
        showAlert(t.must_select_record);
        return;
      }
      if (currentZoneIndex < selectedZones.length - 1) {
        currentZoneIndex++;
        loadRecordsForZone(currentZoneIndex);
      } else {
        goToStep(4);
      }
    });

    document.getElementById('btn-add-record')?.addEventListener('click', createNewRecord);
    document.getElementById('btn-step4-back')?.addEventListener('click', () => goToStep(3));
    document.getElementById('btn-step4-next')?.addEventListener('click', () => goToStep(5));
    document.getElementById('btn-step5-back')?.addEventListener('click', () => goToStep(4));
    document.getElementById('btn-save-final')?.addEventListener('click', saveConfiguration);

    // One-click Copy Button
    document.getElementById('btn-copy-cmd')?.addEventListener('click', () => {
      const cmdText = document.getElementById('cmd-to-run')?.innerText || './c2go';
      navigator.clipboard.writeText(cmdText).then(() => {
        const copyTextEl = document.getElementById('btn-copy-text');
        if (copyTextEl) {
          copyTextEl.innerText = currentLang === 'es' ? '¡Copiado!' : 'Copied!';
          setTimeout(() => {
            copyTextEl.innerText = currentLang === 'es' ? 'Copiar' : 'Copy';
          }, 2000);
        }
      });
    });

    loadInitial();
  });
</script>
