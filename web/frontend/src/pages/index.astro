---
import Layout from '../layouts/Layout.astro';
---

<Layout title="c2go | Dynamic DNS Control Center">
  <!-- Top Navigation Bar -->
  <header class="border-b border-zinc-800/80 bg-zinc-950/90 backdrop-blur-xl sticky top-0 z-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 h-14 flex items-center justify-between">
      <div class="flex items-center gap-3">
        <div class="w-7 h-7 rounded-lg bg-gradient-to-br from-rose-500 to-rose-700 flex items-center justify-center text-white shadow-sm shadow-rose-950/40">
          <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
        </div>
        <div class="flex items-center gap-2">
          <span class="font-bold text-sm text-zinc-100 tracking-tight">c2go</span>
          <span id="header-mode-badge" class="px-2 py-0.5 rounded bg-zinc-850 text-[10px] font-mono text-zinc-400 border border-zinc-750 flex items-center gap-1.5">
            <span class="w-1.5 h-1.5 rounded-full bg-zinc-500" id="header-badge-dot"></span>
            <span id="header-badge-text">Initializing...</span>
          </span>
        </div>
      </div>

      <div class="flex items-center gap-3">
        <!-- Public IP Badge -->
        <div class="flex items-center gap-2 px-2.5 py-1 bg-zinc-900 border border-zinc-800 rounded-lg text-xs font-mono">
          <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
          <span class="text-zinc-400" id="top-ip-lbl">IP:</span>
          <span class="text-zinc-200 font-semibold" id="top-ip-val">...</span>
        </div>

        <!-- Language Switcher -->
        <select id="input-lang" class="px-2.5 py-1 bg-zinc-900 border border-zinc-800 rounded-lg text-xs text-zinc-300 focus:outline-none focus:border-rose-500 cursor-pointer font-medium">
          <option value="en">EN</option>
          <option value="es">ES</option>
        </select>
      </div>
    </div>
  </header>

  <!-- Initial Smooth Loading Skeleton (Prevents any UI Flash) -->
  <div id="view-loader" class="max-w-7xl mx-auto w-full px-4 sm:px-6 py-12 flex flex-col items-center justify-center min-h-[400px] space-y-4">
    <div class="w-8 h-8 rounded-full border-2 border-rose-500/20 border-t-rose-500 animate-spin"></div>
    <div class="text-xs font-mono text-zinc-400 animate-pulse">Loading system configuration...</div>
  </div>

  <!-- ========================================================================= -->
  <!-- VIEW 1: PRODUCTION DASHBOARD (Shown when is_configured == true) -->
  <!-- ========================================================================= -->
  <main id="view-dashboard" class="max-w-7xl mx-auto w-full px-4 sm:px-6 py-6 sm:py-8 space-y-6 hidden">
    
    <!-- Top KPI Metrics Grid -->
    <section class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
      <!-- Card 1: Live Public IP -->
      <div class="bg-zinc-900/60 border border-zinc-800/80 rounded-xl p-4.5 backdrop-blur-md relative overflow-hidden group">
        <div class="absolute -right-6 -bottom-6 w-24 h-24 bg-rose-500/5 rounded-full blur-xl pointer-events-none"></div>
        <div class="flex items-center justify-between text-xs text-zinc-400 mb-2">
          <span class="font-medium">Active Public IP</span>
          <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
        </div>
        <div class="flex items-baseline justify-between">
          <div class="font-mono text-lg sm:text-xl font-bold text-zinc-100 tracking-tight" id="kpi-public-ip">...</div>
          <button type="button" id="btn-copy-kpi-ip" class="text-zinc-400 hover:text-zinc-200 text-xs p-1 rounded bg-zinc-800/80 border border-zinc-700/80 cursor-pointer" title="Copy IP">
            <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="14" height="14" x="8" y="8" rx="2" ry="2"/><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/></svg>
          </button>
        </div>
        <div class="text-[11px] text-zinc-400 mt-2 flex items-center gap-1.5 font-mono">
          <span>NIC Binding:</span>
          <span class="text-rose-400 font-semibold" id="kpi-primary-nic">Auto</span>
        </div>
      </div>

      <!-- Card 2: Monitored DNS Records -->
      <div class="bg-zinc-900/60 border border-zinc-800/80 rounded-xl p-4.5 backdrop-blur-md relative overflow-hidden">
        <div class="flex items-center justify-between text-xs text-zinc-400 mb-2">
          <span class="font-medium">Monitored Records</span>
          <svg class="w-4 h-4 text-zinc-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"/><path d="M2 12h20"/></svg>
        </div>
        <div class="flex items-baseline gap-2">
          <div class="font-mono text-lg sm:text-xl font-bold text-zinc-100" id="kpi-records-count">0</div>
          <span class="text-xs text-zinc-400" id="kpi-records-sub">records</span>
        </div>
        <div class="text-[11px] text-zinc-400 mt-2 font-mono flex items-center gap-1.5">
          <span>Across:</span>
          <span class="text-zinc-300 font-semibold" id="kpi-zones-count">0 zones</span>
        </div>
      </div>

      <!-- Card 3: Sync Engine Frequency -->
      <div class="bg-zinc-900/60 border border-zinc-800/80 rounded-xl p-4.5 backdrop-blur-md relative overflow-hidden">
        <div class="flex items-center justify-between text-xs text-zinc-400 mb-2">
          <span class="font-medium">Sync Engine</span>
          <svg class="w-4 h-4 text-zinc-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2v4M12 18v4M4.93 4.93l2.83 2.83M16.24 16.24l2.83 2.83M2 12h4M18 12h4M4.93 19.07l2.83-2.83M16.24 7.76l2.83-2.83"/></svg>
        </div>
        <div class="flex items-baseline gap-2">
          <div class="font-mono text-lg sm:text-xl font-bold text-zinc-100" id="kpi-interval-val">300s</div>
          <span class="text-xs text-zinc-400 font-mono" id="kpi-interval-human">(5m)</span>
        </div>
        <div class="text-[11px] text-zinc-400 mt-2 flex items-center gap-1.5 font-mono">
          <span>NetWatcher:</span>
          <span class="text-emerald-400 font-semibold">Active & Event-driven</span>
        </div>
      </div>

      <!-- Card 4: Daemon & Service -->
      <div class="bg-zinc-900/60 border border-zinc-800/80 rounded-xl p-4.5 backdrop-blur-md relative overflow-hidden">
        <div class="flex items-center justify-between text-xs text-zinc-400 mb-2">
          <span class="font-medium">Service Status</span>
          <div id="dash-kpi-pill" class="w-2 h-2 rounded-full bg-zinc-500"></div>
        </div>
        <div class="font-mono text-sm sm:text-base font-bold text-zinc-100 truncate" id="dash-kpi-service-label">Standalone CLI</div>
        <div class="text-[11px] text-zinc-400 mt-2 flex items-center gap-1.5 font-mono truncate" id="dash-kpi-service-sub">
          <span>Target:</span>
          <span class="text-zinc-300">./c2go</span>
        </div>
      </div>
    </section>

    <!-- Main Dashboard Grid (2 Columns: 8 cols Workspace, 4 cols Quick Configuration) -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 sm:gap-8 items-start">
      
      <!-- Left 8 Columns: Dynamic DNS Operations & History -->
      <div class="lg:col-span-8 space-y-6">
        
        <!-- Toast / Action Feedback Banner -->
        <div id="dash-alert-box" class="p-3.5 rounded-lg text-xs font-medium flex items-center gap-2.5 hidden"></div>

        <!-- Section 1: IP Change History Audit Log (Live Metrics & Audit) -->
        <section class="bg-zinc-900/50 border border-zinc-800/80 rounded-xl p-5 sm:p-6 backdrop-blur-md shadow-sm space-y-4">
          <div class="flex items-center justify-between border-b border-zinc-800/60 pb-3">
            <div class="flex items-center gap-2.5">
              <div class="w-6 h-6 rounded-md bg-rose-500/10 text-rose-400 border border-rose-500/20 flex items-center justify-center">
                <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 14 14"/></svg>
              </div>
              <h2 class="text-sm sm:text-base font-bold text-zinc-100">IP Change History & Activity Audit</h2>
            </div>
            <span class="text-[11px] font-mono text-zinc-400" id="history-count-badge">0 events</span>
          </div>

          <!-- History Entries Table / Timeline -->
          <div class="overflow-x-auto max-h-[220px] overflow-y-auto pr-1">
            <table class="w-full text-left text-xs font-mono">
              <thead class="text-[11px] uppercase tracking-wider text-zinc-400 border-b border-zinc-800 bg-zinc-950/40 sticky top-0">
                <tr>
                  <th class="py-2 px-3">Timestamp</th>
                  <th class="py-2 px-3">Detected Public IP</th>
                  <th class="py-2 px-3 text-right">Status</th>
                </tr>
              </thead>
              <tbody id="history-table-body" class="divide-y divide-zinc-800/40 text-zinc-300">
                <tr>
                  <td colspan="3" class="py-6 text-center text-zinc-500 font-sans text-xs">No IP change events recorded yet in history.json</td>
                </tr>
              </tbody>
            </table>
          </div>
        </section>

        <!-- Section 2: Multi-NIC Priority & Adapter Routing -->
        <section class="bg-zinc-900/50 border border-zinc-800/80 rounded-xl p-5 sm:p-6 backdrop-blur-md shadow-sm space-y-4">
          <div class="flex items-center justify-between border-b border-zinc-800/60 pb-3">
            <div class="flex items-center gap-2.5">
              <div class="w-6 h-6 rounded-md bg-rose-500/10 text-rose-400 border border-rose-500/20 flex items-center justify-center">
                <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="20" height="8" x="2" y="2" rx="2"/><rect width="20" height="8" x="2" y="14" rx="2"/><line x1="6" x2="6.01" y1="6" y2="6"/><line x1="6" x2="6.01" y1="18" y2="18"/></svg>
              </div>
              <div>
                <h2 class="text-sm sm:text-base font-bold text-zinc-100">Network Interfaces (Multi-NIC Priority)</h2>
              </div>
            </div>
            <span class="text-[11px] font-mono text-zinc-400" id="dash-nics-badge-count">0 detected</span>
          </div>

          <p class="text-xs text-zinc-400 leading-relaxed">
            Prioritize network adapters (Ethernet, Wi-Fi, 4G/5G). c2go binds its socket directly to the highest priority active interface and falls back seamlessly if connection drops.
          </p>

          <div id="dash-interfaces-list" class="space-y-2 pt-1">
            <div class="text-xs text-zinc-500 py-4 text-center border border-zinc-800/60 rounded-lg">Scanning network adapters...</div>
          </div>
        </section>

        <!-- Section 3: Managed Zones & DNS Records -->
        <section class="bg-zinc-900/50 border border-zinc-800/80 rounded-xl p-5 sm:p-6 backdrop-blur-md shadow-sm space-y-4">
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 border-b border-zinc-800/60 pb-3">
            <div class="flex items-center gap-2.5">
              <div class="w-6 h-6 rounded-md bg-rose-500/10 text-rose-400 border border-rose-500/20 flex items-center justify-center">
                <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"/><path d="M2 12h20"/></svg>
              </div>
              <h2 class="text-sm sm:text-base font-bold text-zinc-100">Managed Domains & Records</h2>
            </div>
            <!-- Domain Switcher -->
            <div class="flex items-center gap-2">
              <span class="text-xs text-zinc-400 font-mono">Domain:</span>
              <select id="dash-domain-select" class="px-3 py-1.5 bg-zinc-950 border border-zinc-800 rounded-lg text-xs font-mono text-zinc-200 focus:outline-none focus:border-rose-500 cursor-pointer"></select>
            </div>
          </div>

          <!-- Records Cards Grid -->
          <div id="dash-records-grid" class="grid grid-cols-1 sm:grid-cols-2 gap-2.5 max-h-[260px] overflow-y-auto pr-1"></div>

          <!-- Inline Record Creator -->
          <div class="p-3.5 bg-zinc-950/70 border border-dashed border-zinc-750 rounded-xl space-y-2.5 mt-2">
            <span class="text-xs font-semibold text-zinc-300 block">Add New DNS A Record to Active Domain:</span>
            <div class="grid grid-cols-1 sm:grid-cols-[1fr_auto_auto] gap-2 items-center">
              <input type="text" id="dash-new-record-name" placeholder="subdomain (e.g. vpn or dev)" class="px-3 py-2 bg-zinc-900 border border-zinc-800 rounded-lg text-zinc-100 text-xs font-mono focus:outline-none focus:border-rose-500" />
              <label class="flex items-center gap-1.5 text-xs font-medium text-zinc-200 cursor-pointer select-none px-2.5 py-2 bg-zinc-900 rounded-lg border border-zinc-800">
                <input type="checkbox" id="dash-new-record-proxied" class="w-3.5 h-3.5 rounded border-zinc-700 bg-zinc-950 text-rose-600 focus:ring-rose-500">
                <span>Proxy</span>
              </label>
              <button type="button" id="btn-dash-add-record" class="px-3.5 py-2 rounded-lg bg-zinc-800 hover:bg-zinc-700 text-zinc-100 font-medium text-xs border border-zinc-700 cursor-pointer">Add Record</button>
            </div>
          </div>
        </section>

      </div>

      <!-- Right 4 Columns: Configuration Settings & Service Panel -->
      <aside class="lg:col-span-4 space-y-6">
        
        <!-- Action Card: Save Settings -->
        <div class="bg-gradient-to-b from-zinc-900 to-zinc-950 border border-zinc-800 rounded-xl p-5 space-y-4 shadow-md">
          <div class="flex items-center justify-between">
            <span class="text-xs font-bold uppercase tracking-wider text-zinc-300">Configuration Actions</span>
            <span class="px-2 py-0.5 rounded bg-emerald-500/15 text-emerald-300 border border-emerald-500/30 text-[10px] font-mono">Ready</span>
          </div>

          <button type="button" id="btn-dash-save" class="w-full py-3 px-4 rounded-lg bg-rose-600 hover:bg-rose-700 text-white font-semibold text-xs sm:text-sm transition-all shadow-md shadow-rose-950 flex items-center justify-center gap-2 cursor-pointer active:scale-[0.98]">
            <span id="dash-btn-text-save">Save & Apply Changes</span>
            <span id="dash-btn-spin-save" class="w-3.5 h-3.5 border-2 border-white/20 border-t-white rounded-full animate-spin hidden"></span>
          </button>

          <div class="pt-2 border-t border-zinc-800/60 flex justify-between items-center text-[11px]">
            <span class="text-zinc-500 font-mono">config.json</span>
            <button type="button" id="btn-relaunch-wizard" class="text-rose-400 hover:text-rose-300 font-medium cursor-pointer">
              Run Setup Wizard Again &#8594;
            </button>
          </div>
        </div>

        <!-- Automation & Interval Options -->
        <div class="bg-zinc-900/50 border border-zinc-800/80 rounded-xl p-5 space-y-4 backdrop-blur-md">
          <h3 class="text-xs font-bold uppercase tracking-wider text-zinc-300">Automation Settings</h3>
          
          <div class="space-y-2">
            <label class="text-xs font-medium text-zinc-400 block">Fallback Check Interval</label>
            <div class="grid grid-cols-2 gap-1.5">
              <button type="button" class="dash-interval-chip px-2.5 py-2 rounded-lg border border-zinc-800 bg-zinc-950 text-zinc-300 font-mono text-xs hover:border-zinc-700 cursor-pointer" data-val="60">60s (1m)</button>
              <button type="button" class="dash-interval-chip active px-2.5 py-2 rounded-lg border border-rose-500 bg-rose-500/10 text-rose-300 font-mono text-xs font-semibold cursor-pointer" data-val="300">300s (5m)</button>
              <button type="button" class="dash-interval-chip px-2.5 py-2 rounded-lg border border-zinc-800 bg-zinc-950 text-zinc-300 font-mono text-xs hover:border-zinc-700 cursor-pointer" data-val="600">600s (10m)</button>
              <button type="button" class="dash-interval-chip px-2.5 py-2 rounded-lg border border-zinc-800 bg-zinc-950 text-zinc-300 font-mono text-xs hover:border-zinc-700 cursor-pointer" data-val="1800">1800s (30m)</button>
            </div>
            <input type="hidden" id="dash-input-interval" value="300" />
          </div>

          <div class="space-y-2 pt-2 border-t border-zinc-800/60 text-xs">
            <div class="flex items-center justify-between py-1">
              <span class="text-zinc-300">Audit History Logging</span>
              <input type="checkbox" id="dash-input-history" checked class="w-4 h-4 rounded border-zinc-700 bg-zinc-950 text-rose-600 focus:ring-rose-500 cursor-pointer">
            </div>
            <div class="flex items-center justify-between py-1">
              <span class="text-zinc-300">GitHub Release Alerts</span>
              <input type="checkbox" id="dash-input-updates" checked class="w-4 h-4 rounded border-zinc-700 bg-zinc-950 text-rose-600 focus:ring-rose-500 cursor-pointer">
            </div>
            <div class="flex items-center justify-between py-1">
              <span class="text-zinc-300">Auto Self-Update</span>
              <input type="checkbox" id="dash-input-autoupdate" class="w-4 h-4 rounded border-zinc-700 bg-zinc-950 text-rose-600 focus:ring-rose-500 cursor-pointer">
            </div>
          </div>
        </div>

        <!-- Cloudflare API Credentials -->
        <div class="bg-zinc-900/50 border border-zinc-800/80 rounded-xl p-5 space-y-3.5 backdrop-blur-md">
          <h3 class="text-xs font-bold uppercase tracking-wider text-zinc-300">Cloudflare API Token</h3>
          <div class="space-y-1.5">
            <div class="relative">
              <input type="password" id="dash-input-token" class="w-full px-3 py-2 bg-zinc-950 border border-zinc-800 rounded-lg text-zinc-100 placeholder-zinc-500 font-mono text-xs focus:outline-none focus:border-rose-500 pr-12" placeholder="Cloudflare API Token" />
              <button type="button" id="btn-dash-toggle-token" class="absolute right-2 top-1/2 -translate-y-1/2 text-[10px] text-zinc-400 hover:text-zinc-200 px-1.5 py-0.5 rounded bg-zinc-900 border border-zinc-800 font-mono cursor-pointer">Show</button>
            </div>
            <p class="text-[10px] text-zinc-500">Stored in system keyring / protected config fallback.</p>
          </div>
        </div>

        <!-- Service / Host Commands -->
        <div class="bg-zinc-900/50 border border-zinc-800/80 rounded-xl p-5 space-y-3 backdrop-blur-md">
          <h3 class="text-xs font-bold uppercase tracking-wider text-zinc-300">Daemon Execution</h3>
          <div class="space-y-1.5">
            <div class="text-[11px] text-zinc-400 font-medium" id="dash-lbl-cmd-title">Command to start or restart:</div>
            <div class="flex items-center justify-between p-2.5 bg-zinc-950 rounded-lg border border-zinc-800 font-mono text-xs">
              <code class="text-zinc-200 truncate pr-2" id="dash-cmd-to-run">./c2go</code>
              <button type="button" id="btn-dash-copy-cmd" class="px-2 py-0.5 rounded bg-zinc-800 hover:bg-zinc-700 text-zinc-200 border border-zinc-700 text-[10px] flex-shrink-0 cursor-pointer">
                <span id="dash-btn-copy-text">Copy</span>
              </button>
            </div>
          </div>
          <p class="text-[11px] text-zinc-400 leading-relaxed" id="dash-os-help-note">
            Run the command in your terminal to start background synchronization.
          </p>
        </div>

      </aside>

    </div>
  </main>


  <!-- ========================================================================= -->
  <!-- VIEW 2: ONBOARDING WIZARD (Shown when is_configured == false) -->
  <!-- ========================================================================= -->
  <main id="view-wizard" class="max-w-6xl mx-auto w-full px-4 sm:px-6 py-6 sm:py-8 flex-1 grid grid-cols-1 lg:grid-cols-12 gap-6 sm:gap-8 items-start hidden">
    
    <!-- Left Column: Step Navigation & Realtime Summary (4 cols) -->
    <aside class="lg:col-span-4 space-y-4">
      <div class="bg-zinc-900/40 border border-zinc-800/80 rounded-xl p-4 space-y-1.5 backdrop-blur-sm">
        <h2 class="text-[11px] font-bold uppercase tracking-wider text-zinc-400 px-2 mb-2" id="sidebar-nav-title">Configuration Progress</h2>
        
        <div class="space-y-1" id="wizard-nav-list">
          <div class="step-nav-btn active flex items-start gap-3 p-2.5 rounded-lg transition-all" id="nav-step-1">
            <div class="step-nav-icon w-6 h-6 rounded-md bg-rose-600 text-white flex items-center justify-center text-xs font-bold flex-shrink-0 mt-0.5">1</div>
            <div>
              <div class="font-medium text-xs sm:text-sm text-zinc-100 step-nav-title" id="nav-lbl-1">Authentication</div>
              <div class="text-[11px] text-zinc-400 mt-0.5" id="nav-desc-1">Connect Cloudflare API token</div>
            </div>
          </div>

          <div class="step-nav-btn flex items-start gap-3 p-2.5 rounded-lg transition-all" id="nav-step-2">
            <div class="step-nav-icon w-6 h-6 rounded-md bg-zinc-800 text-zinc-400 border border-zinc-700 flex items-center justify-center text-xs font-bold flex-shrink-0 mt-0.5">2</div>
            <div>
              <div class="font-medium text-xs sm:text-sm text-zinc-400 step-nav-title" id="nav-lbl-2">Managed Domains</div>
              <div class="text-[11px] text-zinc-500 mt-0.5" id="nav-desc-2">Select zones to monitor</div>
            </div>
          </div>

          <div class="step-nav-btn flex items-start gap-3 p-2.5 rounded-lg transition-all" id="nav-step-3">
            <div class="step-nav-icon w-6 h-6 rounded-md bg-zinc-800 text-zinc-400 border border-zinc-700 flex items-center justify-center text-xs font-bold flex-shrink-0 mt-0.5">3</div>
            <div>
              <div class="font-medium text-xs sm:text-sm text-zinc-400 step-nav-title" id="nav-lbl-3">DNS Records</div>
              <div class="text-[11px] text-zinc-500 mt-0.5" id="nav-desc-3">Pick A records to update</div>
            </div>
          </div>

          <div class="step-nav-btn flex items-start gap-3 p-2.5 rounded-lg transition-all" id="nav-step-4">
            <div class="step-nav-icon w-6 h-6 rounded-md bg-zinc-800 text-zinc-400 border border-zinc-700 flex items-center justify-center text-xs font-bold flex-shrink-0 mt-0.5">4</div>
            <div>
              <div class="font-medium text-xs sm:text-sm text-zinc-400 step-nav-title" id="nav-lbl-4">Automation</div>
              <div class="text-[11px] text-zinc-500 mt-0.5" id="nav-desc-4">Sync intervals & auto-update</div>
            </div>
          </div>

          <div class="step-nav-btn flex items-start gap-3 p-2.5 rounded-lg transition-all" id="nav-step-5">
