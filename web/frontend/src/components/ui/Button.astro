---
interface Props {
  variant?: 'primary' | 'secondary' | 'outline';
  id?: string;
  class?: string;
  type?: 'button' | 'submit' | 'reset';
  disabled?: boolean;
}

const { variant = 'primary', id, class: className = '', type = 'button', disabled = false } = Astro.props;

const variants = {
  primary: 'bg-rose-600 hover:bg-rose-700 text-white shadow-md shadow-rose-900/40 hover:shadow-rose-900/60',
  secondary: 'bg-zinc-850 hover:bg-zinc-750 text-zinc-100 border border-zinc-700 hover:border-zinc-600',
  outline: 'bg-transparent hover:bg-zinc-850 text-zinc-300 border border-zinc-700',
};
---

<button
  id={id}
  type={type}
  disabled={disabled}
  class={`inline-flex items-center justify-center gap-2.5 px-6 py-3 rounded-xl text-base font-semibold transition-all duration-150 active:scale-[0.98] disabled:opacity-50 disabled:cursor-not-allowed cursor-pointer ${variants[variant]} ${className}`}
>
  <slot />
</button>
