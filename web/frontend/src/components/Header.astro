---
import Badge from './ui/Badge.astro';
---

<header class="text-center mb-10">
  <div class="flex justify-center mb-4">
    <Badge variant="brand" class="text-sm py-1 px-3.5">
      <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
      <span>c2go DDNS Client</span>
    </Badge>
  </div>
  <h1 id="ui-title" class="text-3xl sm:text-4xl font-extrabold tracking-tight text-zinc-50">Initial Configuration</h1>
  <p id="ui-subtitle" class="text-base sm:text-lg text-zinc-400 mt-2 max-w-xl mx-auto">Configure Cloudflare credentials, managed zones, and DNS records</p>
</header>
