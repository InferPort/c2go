---
import Input from './ui/Input.astro';
import Button from './ui/Button.astro';
---

<div id="step-1" class="space-y-6">
  <div class="space-y-2">
    <label class="text-xs font-bold uppercase tracking-wider text-zinc-400 block" id="lbl-language">Language / Idioma</label>
    <select id="input-lang" class="w-full px-4 py-3 bg-zinc-900 border border-zinc-800 rounded-xl text-zinc-100 text-base focus:outline-none focus:border-rose-500 focus:ring-2 focus:ring-rose-500/20 cursor-pointer">
      <option value="en">English</option>
      <option value="es">Español</option>
    </select>
  </div>

  <div class="space-y-2">
    <label class="text-xs font-bold uppercase tracking-wider text-zinc-400 block" id="lbl-token">Cloudflare API Token</label>
    <span class="text-sm text-zinc-400 block" id="lbl-token-desc">Needs Zone:Read and DNS:Edit permissions across managed domains.</span>
    <Input id="input-token" type="password" placeholder="Paste your API token here" mono={true} />
  </div>

  <div class="flex justify-end pt-6 border-t border-zinc-800/80">
    <Button id="btn-step1-next" variant="primary">
      <span id="btn-text-step1">Verify & Continue</span>
      <span id="btn-spin-step1" class="w-5 h-5 border-2 border-white/20 border-t-white rounded-full animate-spin hidden"></span>
    </Button>
  </div>
</div>
